":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID36","PrivateData":false}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID360","SecondaryAttribute":"Which response do you think the writer would be more likely to listen to?","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong>Which response do you think the writer would be more likely to listen to?<\/strong><\/p>","DefaultChoices":false,"DataExportTag":"l_2228","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Which response do you think the writer would be more likely to listen to?","Choices":{"1":{"Display":"Definitely Response A"},"2":{"Display":"Probably Response A"},"3":{"Display":"About equally likely to listen to both"},"4":{"Display":"Probably Response B"},"5":{"Display":"Definitely Response B"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID360","PrivateData":false}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID361","SecondaryAttribute":"If you had a personal problem of your own, which of these two commenters would y","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong>If you had a personal problem of your own, which of these two commenters would you rather get advice from?<\/strong><\/p>","DefaultChoices":false,"DataExportTag":"a_2228","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"If you had a personal problem of your own, which of these two commenters would y","Choices":{"1":{"Display":"Definitely commenter A"},"2":{"Display":"Probably commenter A"},"3":{"Display":"No preference"},"4":{"Display":"Probably commenter B"},"5":{"Display":"Definitely commenter B"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID361","PrivateData":false}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID362","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"t_r_2228","QuestionID":"QID362","QuestionType":"Timing","Selector":"PageTimer","DataVisibility":{"Private":false,"Hidden":true},"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3","4"],"Configuration":{"QuestionDescriptionOption":"UseText"}}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID363","SecondaryAttribute":"Situation Am I wrong for refusing to celebrate Hanukkah with my wife and son? La","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"margin:0 0 12px 0\"><div style=\"margin:0 0 4px 0;font-weight:600\">Situation<\/div><div style=\"white-space:pre-wrap;overflow:visible;height:auto;min-height:4em;background:#f7f6f3;border:1px solid #d9d6cf;padding:12px;line-height:1.45\">Am I wrong for refusing to celebrate Hanukkah with my wife and son? Last year my wife and I had our first child, a son. She had mentioned to me last year that she would like to do something with Hanukkah in the future when our son was older but did not say more than that so it wasn&#x27;t discussed.\n\nShe mentioned it to me again this year (a few times actually in the past few weeks), and I told her it wasn&#x27;t my thing (I&#x27;m not Jewish) so I would not participate but she was welcome to have it with our son if she wanted. Then today she came to me talking about what we were supposed to do tonight, and I told her that I wasn&#x27;t participating.\n\nShe has been upset all day with me, but I don&#x27;t want to celebrate it. She said that it isn&#x27;t fair since she celebrates Christmas with my family and has since we&#x27;ve been married, but as I pointed out to her, I never forced her to celebrate Christmas. She did that because she wanted to bond with my family. Again, her choice; I never pressured her to do it. I also did not force her to covert for me. That was also her choice.\n\nI think the most she can expect is that I respect her decision if she wants to do Hanukkah with our child(ren).\n\nAm I wrong?<\/div><\/div><p><strong>Do you think the writer was in the wrong?<\/strong><\/p>","DefaultChoices":false,"DataExportTag":"v_524","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Situation Am I wrong for refusing to celebrate Hanukkah with my wife and son? La","Choices":{"1":{"Display":"Definitely not in the wrong"},"2":{"Display":"Probably not in the wrong"},"3":{"Display":"Unsure"},"4":{"Display":"Probably in the wrong"},"5":{"Display":"Definitely in the wrong"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID363","PrivateData":false}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID364","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"t_v_524","QuestionID":"QID364","QuestionType":"Timing","Selector":"PageTimer","DataVisibility":{"Private":false,"Hidden":true},"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3","4"],"Configuration":{"QuestionDescriptionOption":"UseText"}}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID365","SecondaryAttribute":"Situation Am I wrong for refusing to celebrate Hanukkah with my wife and son? La","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"margin:0 0 12px 0\"><div style=\"margin:0 0 4px 0;font-weight:600\">Situation<\/div><div style=\"white-space:pre-wrap;overflow:visible;height:auto;min-height:4em;background:#f7f6f3;border:1px solid #d9d6cf;padding:12px;line-height:1.45\">Am I wrong for refusing to celebrate Hanukkah with my wife and son? Last year my wife and I had our first child, a son. She had mentioned to me last year that she would like to do something with Hanukkah in the future when our son was older but did not say more than that so it wasn&#x27;t discussed.\n\nShe mentioned it to me again this year (a few times actually in the past few weeks), and I told her it wasn&#x27;t my thing (I&#x27;m not Jewish) so I would not participate but she was welcome to have it with our son if she wanted. Then today she came to me talking about what we were supposed to do tonight, and I told her that I wasn&#x27;t participating.\n\nShe has been upset all day with me, but I don&#x27;t want to celebrate it. She said that it isn&#x27;t fair since she celebrates Christmas with my family and has since we&#x27;ve been married, but as I pointed out to her, I never forced her to celebrate Christmas. She did that because she wanted to bond with my family. Again, her choice; I never pressured her to do it. I also did not force her to covert for me. That was also her choice.\n\nI think the most she can expect is that I respect her decision if she wants to do Hanukkah with our child(ren).\n\nAm I wrong?<\/div><\/div><p><em>You can re-read the situation above while evaluating the responses.<\/em><\/p><p>Here are two responses to the writer.<\/p><div style=\"display:grid;grid-template-columns:1fr 1fr;gap:12px;align-items:start\"><div style=\"margin:0 0 12px 0\"><div style=\"margin:0 0 4px 0;font-weight:600\">Response A<\/div><div style=\"white-space:pre-wrap;overflow:visible;height:auto;min-height:4em;background:#f7f6f3;border:1px solid #d9d6cf;padding:12px;line-height:1.45\">${e:\/\/Field\/Option A}<\/div><\/div><div style=\"margin:0 0 12px 0\"><div style=\"margin:0 0 4px 0;font-weight:600\">Response B<\/div><div style=\"white-space:pre-wrap;overflow:visible;height:auto;min-height:4em;background:#f7f6f3;border:1px solid #d9d6cf;padding:12px;line-height:1.45\">${e:\/\/Field\/Option B}<\/div><\/div><\/div><p><strong>Overall, how good is each response?<\/strong><\/p><p>Rate each response:<\/p><p><strong>Response A<\/strong><\/p>","DefaultChoices":false,"DataExportTag":"gA_524","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Situation Am I wrong for refusing to celebrate Hanukkah with my wife and son? La","Choices":{"1":{"Display":"Very bad"},"2":{"Display":"Bad"},"3":{"Display":"Somewhat bad"},"4":{"Display":"Neither good nor bad"},"5":{"Display":"Somewhat good"},"6":{"Display":"Good"},"7":{"Display":"Very good"}},"ChoiceOrder":["1","2","3","4","5","6","7"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID365","PrivateData":false}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID366","SecondaryAttribute":"Response B","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong>Response B<\/strong><\/p>","DefaultChoices":false,"DataExportTag":"gB_524","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Response B","Choices":{"1":{"Display":"Very bad"},"2":{"Disp