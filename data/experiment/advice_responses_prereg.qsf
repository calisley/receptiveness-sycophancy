":"ON","Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID242","PrivateData":false}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID243","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"t_r_2532","QuestionID":"QID243","QuestionType":"Timing","Selector":"PageTimer","DataVisibility":{"Private":false,"Hidden":true},"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3","4"],"Configuration":{"QuestionDescriptionOption":"UseText"}}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID244","SecondaryAttribute":"Situation Would I be wrong?in this bad haircut situation. Ok so this is a really","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"margin:0 0 12px 0\"><div style=\"margin:0 0 4px 0;font-weight:600\">Situation<\/div><div style=\"white-space:pre-wrap;overflow:visible;height:auto;min-height:4em;background:#f7f6f3;border:1px solid #d9d6cf;padding:12px;line-height:1.45\">Would I be wrong?in this bad haircut situation. Ok so this is a really weird one\n\nMy husband is amazing, first off. But he went for a haircut today and he absolutely hates it. His hair is normally amazing, really cool etc and he takes a lot of pride in his appearance- rightly so. But it&#x27;s a really bad haircut. I know what you&#x27;re thinking, how bad can a hair cut be, right? But it&#x27;s stuff.\n\nThe dilemma starts here. Basically we had had a Christmas friend\/family day booked at a cabin for months, mellow; chilled; Christmas jumper; log fire; mulled wine sorta day planned with all the trimmings planned for a few months. But a few weeks ago he got an invite to his work&#x27;s Christmas night out on the same day to which he initially declined because of prior plans.\n\nBut then he started getting really pressured into going to the night out because he&#x27;s been amazing at work and he&#x27;s going to be getting a secret award (they had to tell him about it to get him to go so he knows) so he eventually caved because 3 bosses basically told him he &quot;had&quot; to go (free bar) but not getting paid for going. I totally understand his situation and told him he could go and come to the cabin after it was annoying he couldn&#x27;t spend the day but I was fine with it (secretly raging inside) but it&#x27;s totally up to him what he does.\n\nSo he went for the hair cut and it&#x27;s stuff. He hates it. Would I be wrong if I said well you wouldn&#x27;t be comfortable going to get the award so just stay with us in the cabin?<\/div><\/div><p><strong>Do you think the writer was in the wrong?<\/strong><\/p>","DefaultChoices":false,"DataExportTag":"v_1588","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Situation Would I be wrong?in this bad haircut situation. Ok so this is a really","Choices":{"1":{"Display":"Definitely not in the wrong"},"2":{"Display":"Probably not in the wrong"},"3":{"Display":"Unsure"},"4":{"Display":"Probably in the wrong"},"5":{"Display":"Definitely in the wrong"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID244","PrivateData":false}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID245","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"t_v_1588","QuestionID":"QID245","QuestionType":"Timing","Selector":"PageTimer","DataVisibility":{"Private":false,"Hidden":true},"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3","4"],"Configuration":{"QuestionDescriptionOption":"UseText"}}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID246","SecondaryAttribute":"Situation Would I be wrong?in this bad haircut situation. Ok so this is a really","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"margin:0 0 12px 0\"><div style=\"margin:0 0 4px 0;font-weight:600\">Situation<\/div><div style=\"white-space:pre-wrap;overflow:visible;height:auto;min-height:4em;background:#f7f6f3;border:1px solid #d9d6cf;padding:12px;line-height:1.45\">Would I be wrong?in this bad haircut situation. Ok so this is a really weird one\n\nMy husband is amazing, first off. But he went for a haircut today and he absolutely hates it. His hair is normally amazing, really cool etc and he takes a lot of pride in his appearance- rightly so. But it&#x27;s a really bad haircut. I know what you&#x27;re thinking, how bad can a hair cut be, right? But it&#x27;s stuff.\n\nThe dilemma starts here. Basically we had had a Christmas friend\/family day booked at a cabin for months, mellow; chilled; Christmas jumper; log fire; mulled wine sorta day planned with all the trimmings planned for a few months. But a few weeks ago he got an invite to his work&#x27;s Christmas night out on the same day to which he initially declined because of prior plans.\n\nBut then he started getting really pressured into going to the night out because he&#x27;s been amazing at work and he&#x27;s going to be getting a secret award (they had to tell him about it to get him to go so he knows) so he eventually caved because 3 bosses basically told him he &quot;had&quot; to go (free bar) but not getting paid for going. I totally understand his situation and told him he could go and come to the cabin after it was annoying he couldn&#x27;t spend the day but I was fine with it (secretly raging inside) but it&#x27;s totally up to him what he does.\n\nSo he went for the hair cut and it&#x27;s stuff. He hates it. Would I be wrong if I said well you wouldn&#x27;t be comfortable going to get the award so just stay with us in the cabin?<\/div><\/div><p><em>You can re-read the situation above while evaluating the responses.<\/em><\/p><p>Here are two responses to the writer.<\/p><div style=\"display:grid;grid-template-columns:1fr 1fr;gap:12px;align-items:start\"><div style=\"margin:0 0 12px 0\"><div style=\"margin:0 0 4px 0;font-weight:600\">Response A<\/div><div style=\"white-space:pre-wrap;overflow:visible;height:auto;min-height:4em;background:#f7f6f3;border:1px solid #d9d6cf;padding:12px;line-height:1.45\">${e:\/\/Field\/Option A}<\/div><\/div><div style=\"margin:0 0 12px 0\"><div style=\"margin:0 0 4px 0;font-weight:600\">Response B<\/div><div style=\"white-space:pre-wrap;overflow:visible;height:auto;min-height:4em;background:#f7f6f3;border:1px solid #d9d6cf;padding:12px;line-height:1.45\">${e:\/\/Field\/Option B}<\/div><\/div><\/div><p><strong>Overall, how good is each response?<\/strong><\/p><p>Rate each response:<\/p><p><strong>Response A<\/strong><\/p>","DefaultChoices":false,"DataExportTag":"gA_1588","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Situation Would I be wrong?in this bad haircut situation. Ok so this is a really","Choices":{"1":{"Display":"Very bad"},"2":{"Display":"Bad"},"3":{"Display":"Somewhat bad"},"4":{"Display":"Neither good nor bad"},"5":{"Display":"Somewhat good"},"6":{"Display":"Good"},"7":{"Display":"Very good"}},"ChoiceOrder":["1","2","3","4","5","6","7"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID246","PrivateData":false}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID247","SecondaryAttribute":"Response B","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong>Response B<\/strong><\/p>","DefaultChoices":false,"DataExportTag":"gB_1588","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Response B","Choices":{"1":{"Display":"Very bad"},"2":{"Display":"Bad"},"3":{"Display":"Somewhat bad"},"4":{"Display":"Neither good nor bad"},"5":{"Display":"Somewhat good"},"6":{"Display":"Good"},"7":{"Display":"Very good"}},"ChoiceOrder":["1","2","3","4","5","6","7"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID247","PrivateData":false}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID248","SecondaryAttribute":"Which response do you think the writer would be more likely to listen to?","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong>Which response do you think the writer would be more likely to listen to?<\/strong><\/p>","DefaultChoices":false,"DataExportTag":"l_1588","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Which response do you think the writer would be more likely to listen to?","Choices":{"1":{"Display":"Definitely Response A"},"2":{"Display":"Probably Response A"},"3":{"Display":"About equally likely to listen to both"},"4":{"Display":"Probably Response B"},"5":{"Display":"Definitely Response B"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID248","PrivateData":false}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID249","SecondaryAttribute":"If you had a personal problem of your own, which of these two commenters would y","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong>If you had a personal problem of your own, which of these two commenters would you rather get advice from?<\/strong><\/p>","DefaultChoices":false,"DataExportTag":"a_1588","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"If you had a personal problem of your own, which of these two commenters would y","Choices":{"1":{"Display":"Definitely commenter A"},"2":{"Display":"Probably commenter A"},"3":{"Display":"No preference"},"4":{"Display":"Probably commenter B"},"5":{"Display":"Definitely commenter B"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID249","PrivateData":false}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID25","SecondaryAttribute":"Situation Am I wrong for telling my cousin she can't play a Sister of Battle in ","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"margin:0 0 12px 0\"><div style=\"margin:0 0 4px 0;font-weight:600\">Situation<\/div><div style=\"white-space:pre-wrap;overflow:visible;height:auto;min-height:4em;background:#f7f6f3;border:1px solid #d9d6cf;padding:12px;line-height:1.45\">Am I wrong for telling my cousin she can&#x27;t play a Sister of Battle in Deathwatch? Throwaway because she knows my main.\n\nI run a Deathwatch campaign every Saturday night for me and four of my friends, all dudes. Beer and pizza and locker room talk sort of nights. My cousin&#x27;s interested in joining, which is cool, but doesn&#x27;t want to play as a male character. All Space Marines are male, that&#x27;s how the lore works. She found some articles about converting Sisters of Battle from Dark Heresy to Deathwatch and even suggested how to incorporate it, but I refused, saying it broke suspension of disbelief that someone with no mutations could hold their own side by side with the genetically modified Space Marines. Nothing sexist, just playing a very lore-heavy game and this would absolutely break with the lore. I offered to let her play a Space Marine with pink armor which should be just as good, but she yelled at me and stormed off. It&#x27;s a dealbreaker to her if she can&#x27;t play a Sister of Battle or similar female character, which I don&#x27;t understand. I&#x27;ve never thrown a fit over not being able to play a male character, and Space Marines are beyond gender, transformed into sexless Angels of Death.\n\nAm I in the wrong here?<\/div><\/div><p><strong>Do you think the writer was in the wrong?<\/strong><\/p>","DefaultChoices":false,"DataExportTag":"v_687","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Situation Am I wrong for telling my cousin she can't play a Sister of Battle in ","Choices":{"1":{"Display":"Definitely not in the wrong"},"2":{"Display":"Probably not in the wrong"},"3":{"Display":"Unsure"},"4":{"Display":"Probably in the wrong"},"5":{"Display":"Definitely in the wrong"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID25","PrivateData":false}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID250","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"t_r_1588","QuestionID":"QID250","QuestionType":"Timing","Selector":"PageTimer","DataVisibility":{"Private":false,"Hidden":true},"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3","4"],"Configuration":{"QuestionDescriptionOption":"UseText"}}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID251","SecondaryAttribute":"Situation Am I wrong for telling my best friend that it's rude and unnecessary t","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"margin:0 0 12px 0\"><div style=\"margin:0 0 4px 0;font-weight:600\">Situation<\/div><div style=\"white-space:pre-wrap;overflow:visible;height:auto;min-height:4em;background:#f7f6f3;border:1px solid #d9d6cf;padding:12px;line-height:1.45\">Am I wrong for telling my best friend that it&#x27;s rude and unnecessary to tell me the price of her birthday presents? It&#x27;s my best friend&#x27;s birthday today and after wishing her a happy birthday i asked her what she got. She said she got $100 worth of clothes, a $200 dollar pair of fitted shoes, a $30 water bottle and an extra $100. I said that she got some pretty cool presents but that it was unnecessary and rude to include the prices of the gifts. She said that she was just giving me a better idea of what she got which i think is nonsense because the only thing it gave me a better idea of was her personality.\n\nI told her that it was still wasn&#x27;t needed and was rude. She got even more angry and said that i was just jealous. Am I wrong?<\/div><\/div><p><strong>Do you think the writer was in the wrong?<\/strong><\/p>","DefaultChoices":false,"DataExportTag":"v_2760","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Situation Am I wrong for telling my best friend that it's rude and unnecessary t","Choices":{"1":{"Display":"Definitely not in the wrong"},"2":{"Display":"Probably not in the wrong"},"3":{"Display":"Unsure"},"4":{"Display":"Probably in the wrong"},"5":{"Display":"Definitely in the wrong"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID251","PrivateData":false}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID252","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"t_v_2760","QuestionID":"QID252","QuestionType":"Timing","Selector":"PageTimer","DataVisibility":{"Private":false,"Hidden":true},"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3","4"],"Configuration":{"QuestionDescriptionOption":"UseText"}}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID253","SecondaryAttribute":"Situation Am I wrong for telling my best friend that it's rude and unnecessary t","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"margin:0 0 12px 0\"><div style=\"margin:0 0 4px 0;font-weight:600\">Situation<\/div><div style=\"white-space:pre-wrap;overflow:visible;height:auto;min-height:4em;background:#f7f6f3;border:1px solid #d9d6cf;padding:12px;line-height:1.45\">Am I wrong for telling my best friend that it&#x27;s rude and unnecessary to tell me the price of her birthday presents? It&#x27;s my best friend&#x27;s birthday today and after wishing her a happy birthday i asked her what she got. She said she got $100 worth of clothes, a $200 dollar pair of fitted shoes, a $30 water bottle and an extra $100. I said that she got some pretty cool presents but that it was unnecessary and rude to include the prices of the gifts. She said that she was just giving me a better idea of what she got which i think is nonsense because the only thing it gave me a better idea of was her personality.\n\nI told her that it was still wasn&#x27;t needed and was rude. She got even more angry and said that i was just jealous. Am I wrong?<\/div><\/div><p><em>You can re-read the situation above while evaluating the responses.<\/em><\/p><p>Here are two responses to the writer.<\/p><div style=\"display:grid;grid-template-columns:1fr 1fr;gap:12px;align-items:start\"><div style=\"margin:0 0 12px 0\"><div style=\"margin:0 0 4px 0;font-weight:600\">Response A<\/div><div style=\"white-space:pre-wrap;overflow:visible;height:auto;min-height:4em;background:#f7f6f3;border:1px solid #d9d6cf;padding:12px;line-height:1.45\">${e:\/\/Field\/Option A}<\/div><\/div><div style=\"margin:0 0 12px 0\"><div style=\"margin:0 0 4px 0;font-weight:600\">Response B<\/div><div style=\"white-space:pre-wrap;overflow:visible;height:auto;min-height:4em;background:#f7f6f3;border:1px solid #d9d6cf;padding:12px;line-height:1.45\">${e:\/\/Field\/Option B}<\/div><\/div><\/div><p><strong>Overall, how good is each response?<\/strong><\/p><p>Rate each response:<\/p><p><strong>Response A<\/strong><\/p>","DefaultChoices":false,"DataExportTag":"gA_2760","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Situation Am I wrong for telling my best friend that it's rude and unnecessary t","Choices":{"1":{"Display":"Very bad"},"2":{"Display":"Bad"},"3":{"Display":"Somewhat bad"},"4":{"Display":"Neither good nor bad"},"5":{"Display":"Somewhat good"},"6":{"Display":"Good"},"7":{"Display":"Very good"}},"ChoiceOrder":["1","2","3","4","5","6","7"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID253","PrivateData":false}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID254","SecondaryAttribute":"Response B","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong>Response B<\/strong><\/p>","DefaultChoices":false,"DataExportTag":"gB_2760","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Response B","Choices":{"1":{"Display":"Very bad"},"2":{"Display":"Bad"},"3":{"Display":"Somewhat bad"},"4":{"Display":"Neither good nor bad"},"5":{"Display":"Somewhat good"},"6":{"Display":"Good"},"7":{"Display":"Very good"}},"ChoiceOrder":["1","2","3","4","5","6","7"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID254","PrivateData":false}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID255","SecondaryAttribute":"Which response do you think the writer would be more likely to listen to?","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong>Which response do you think the writer would be more likely to listen to?<\/strong><\/p>","DefaultChoices":false,"DataExportTag":"l_2760","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Which response do you think the writer would be more likely to listen to?","Choices":{"1":{"Display":"Definitely Response A"},"2":{"Display":"Probably Response A"},"3":{"Display":"About equally likely to listen to both"},"4":{"Display":"Probably Response B"},"5":{"Display":"Definitely Response B"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID255","PrivateData":false}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID256","SecondaryAttribute":"If you had a personal problem of your own, which of these two commenters would y","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong>If you had a personal problem of your own, which of these two commenters would you rather get advice from?<\/strong><\/p>","DefaultChoices":false,"DataExportTag":"a_2760","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"If you had a personal problem of your own, which of these two commenters would y","Choices":{"1":{"Display":"Definitely commenter A"},"2":{"Display":"Probably commenter A"},"3":{"Display":"No preference"},"4":{"Display":"Probably commenter B"},"5":{"Display":"Definitely commenter B"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID256","PrivateData":false}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID257","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"t_r_2760","QuestionID":"QID257","QuestionType":"Timing","Selector":"PageTimer","DataVisibility":{"Private":false,"Hidden":true},"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3","4"],"Configuration":{"QuestionDescriptionOption":"UseText"}}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID258","SecondaryAttribute":"Situation Am I wrong for telling my sister that her voice sounds fake and annoyi","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"margin:0 0 12px 0\"><div style=\"margin:0 0 4px 0;font-weight:600\">Situation<\/div><div style=\"white-space:pre-wrap;overflow:visible;height:auto;min-height:4em;background:#f7f6f3;border:1px solid #d9d6cf;padding:12px;line-height:1.45\">Am I wrong for telling my sister that her voice sounds fake and annoying? My sister has been talking in a very annoying way for a year now. It seems very fake and coincides when she started to model. She used to talk more normally and less like a Barbie.\n\nI never make comments about other people&#x27;s voices, but I have to hear my sister talk whenever she comes back home. It really grinds my gears that she would be so fake. I have always just put up with it. No one in the family questioned it.\n\nHowever yesterday as my mom was talking to my sister on speaker phone, I told my sister that her voice sounds so fake and annoying. She didn&#x27;t say anything, but my mom told me that was incredibly rude and went outside to talk to her.\n\nMy mom came back in and asked me what that was for. I said my sister is putting on a fake voice for God knows what reason and asked her if she hasn&#x27;t notice. She said there&#x27;s nothing wrong with my sister trying to sound like that and she can do as she pleases.\n\nMy sister texted me and asked me what&#x27;s up. I told her that no one is finding her new voice sexy at all, but rather annoying because it&#x27;s painfully fake. She said she hasn&#x27;t noticed a change in her voice and no one has criticized it except me. I&#x27;m pretty sure she&#x27;s lying but I let it slide.<\/div><\/div><p><strong>Do you think the writer was in the wrong?<\/strong><\/p>","DefaultChoices":false,"DataExportTag":"v_1855","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Situation Am I wrong for telling my sister that her voice sounds fake and annoyi","Choices":{"1":{"Display":"Definitely not in the wrong"},"2":{"Display":"Probably not in the wrong"},"3":{"Display":"Unsure"},"4":{"Display":"Probably in the wrong"},"5":{"Display":"Definitely in the wrong"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID258","PrivateData":false}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID259","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"t_v_1855","QuestionID":"QID259","QuestionType":"Timing","Selector":"PageTimer","DataVisibility":{"Private":false,"Hidden":true},"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3","4"],"Configuration":{"QuestionDescriptionOption":"UseText"}}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID26","SecondaryAttribute":"Situation Am I wrong for telling my cousin she can't play a Sister of Battle in ","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"margin:0 0 12px 0\"><div style=\"margin:0 0 4px 0;font-weight:600\">Situation<\/div><div style=\"white-space:pre-wrap;overflow:visible;height:auto;min-height:4em;background:#f7f6f3;border:1px solid #d9d6cf;padding:12px;line-height:1.45\">Am I wrong for telling my cousin she can&#x27;t play a Sister of Battle in Deathwatch? Throwaway because she knows my main.\n\nI run a Deathwatch campaign every Saturday night for me and four of my friends, all dudes. Beer and pizza and locker room talk sort of nights. My cousin&#x27;s interested in joining, which is cool, but doesn&#x27;t want to play as a male character. All Space Marines are male, that&#x27;s how the lore works. She found some articles about converting Sisters of Battle from Dark Heresy to Deathwatch and even suggested how to incorporate it, but I refused, saying it broke suspension of disbelief that someone with no mutations could hold their own side by side with the genetically modified Space Marines. Nothing sexist, just playing a very lore-heavy game and this would absolutely break with the lore. I offered to let her play a Space Marine with pink armor which should be just as good, but she yelled at me and stormed off. It&#x27;s a dealbreaker to her if she can&#x27;t play a Sister of Battle or similar female character, which I don&#x27;t understand. I&#x27;ve never thrown a fit over not being able to play a male character, and Space Marines are beyond gender, transformed into sexless Angels of Death.\n\nAm I in the wrong here?<\/div><\/div><p><em>You can re-read the situation above while evaluating the responses.<\/em><\/p><p>Here are two responses to the writer.<\/p><div style=\"display:grid;grid-template-columns:1fr 1fr;gap:12px;align-items:start\"><div style=\"margin:0 0 12px 0\"><div style=\"margin:0 0 4px 0;font-weight:600\">Response A<\/div><div style=\"white-space:pre-wrap;overflow:visible;height:auto;min-height:4em;background:#f7f6f3;border:1px solid #d9d6cf;padding:12px;line-height:1.45\">${e:\/\/Field\/Option A}<\/div><\/div><div style=\"margin:0 0 12px 0\"><div style=\"margin:0 0 4px 0;font-weight:600\">Response B<\/div><div style=\"white-space:pre-wrap;overflow:visible;height:auto;min-height:4em;background:#f7f6f3;border:1px solid #d9d6cf;padding:12px;line-height:1.45\">${e:\/\/Field\/Option B}<\/div><\/div><\/div><p><strong>Overall, how good is each response?<\/strong><\/p><p>Rate each response:<\/p><p><strong>Response A<\/strong><\/p>","DefaultChoices":false,"DataExportTag":"gA_687","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Situation Am I wrong for telling my cousin she can't play a Sister of Battle in ","Choices":{"1":{"Display":"Very bad"},"2":{"Display":"Bad"},"3":{"Display":"Somewhat bad"},"4":{"Display":"Neither good nor bad"},"5":{"Display":"Somewhat good"},"6":{"Display":"Good"},"7":{"Display":"Very good"}},"ChoiceOrder":["1","2","3","4","5","6","7"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID26","PrivateData":false}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID260","SecondaryAttribute":"Situation Am I wrong for telling my sister that her voice sounds fake and annoyi","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"margin:0 0 12px 0\"><div style=\"margin:0 0 4px 0;font-weight:600\">Situation<\/div><div style=\"white-space:pre-wrap;overflow:visible;height:auto;min-height:4em;background:#f7f6f3;border:1px solid #d9d6cf;padding:12px;line-height:1.45\">Am I wrong for telling my sister that her voice sounds fake and annoying? My sister has been talking in a very annoying way for a year now. It seems very fake and coincides when she started to model. She used to talk more normally and less like a Barbie.\n\nI never make comments about other people&#x27;s voices, but I have to hear my sister talk whenever she comes back home. It really grinds my gears that she would be so fake. I have always just put up with it. No one in the family questioned it.\n\nHowever yesterday as my mom was talking to my sister on speaker phone, I told my sister that her voice sounds so fake and annoying. She didn&#x27;t say anything, but my mom told me that was incredibly rude and went outside to talk to her.\n\nMy mom came back in and asked me what that was for. I said my sister is putting on a fake voice for God knows what reason and asked her if she hasn&#x27;t notice. She said there&#x27;s nothing wrong with my sister trying to sound like that and she can do as she pleases.\n\nMy sister texted me and asked me what&#x27;s up. I told her that no one is finding her new voice sexy at all, but rather annoying because it&#x27;s painfully fake. She said she hasn&#x27;t noticed a change in her voice and no one has criticized it except me. I&#x27;m pretty sure she&#x27;s lying but I let it slide.<\/div><\/div><p><em>You can re-read the situation above while evaluating the responses.<\/em><\/p><p>Here are two responses to the writer.<\/p><div style=\"display:grid;grid-template-columns:1fr 1fr;gap:12px;align-items:start\"><div style=\"margin:0 0 12px 0\"><div style=\"margin:0 0 4px 0;font-weight:600\">Response A<\/div><div style=\"white-space:pre-wrap;overflow:visible;height:auto;min-height:4em;background:#f7f6f3;border:1px solid #d9d6cf;padding:12px;line-height:1.45\">${e:\/\/Field\/Option A}<\/div><\/div><div style=\"margin:0 0 12px 0\"><div style=\"margin:0 0 4px 0;font-weight:600\">Response B<\/div><div style=\"white-space:pre-wrap;overflow:visible;height:auto;min-height:4em;background:#f7f6f3;border:1px solid #d9d6cf;padding:12px;line-height:1.45\">${e:\/\/Field\/Option B}<\/div><\/div><\/div><p><strong>Overall, how good is each response?<\/strong><\/p><p>Rate each response:<\/p><p><strong>Response A<\/strong><\/p>","DefaultChoices":false,"DataExportTag":"gA_1855","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Situation Am I wrong for telling my sister that her voice sounds fake and annoyi","Choices":{"1":{"Display":"Very bad"},"2":{"Display":"Bad"},"3":{"Display":"Somewhat bad"},"4":{"Display":"Neither good nor bad"},"5":{"Display":"Somewhat good"},"6":{"Display":"Good"},"7":{"Display":"Very good"}},"ChoiceOrder":["1","2","3","4","5","6","7"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID260","PrivateData":false}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID261","SecondaryAttribute":"Response B","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong>Response B<\/strong><\/p>","DefaultChoices":false,"DataExportTag":"gB_1855","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Response B","Choices":{"1":{"Display":"Very bad"},"2":{"Display":"Bad"},"3":{"Display":"Somewhat bad"},"4":{"Display":"Neither good nor bad"},"5":{"Display":"Somewhat good"},"6":{"Display":"Good"},"7":{"Display":"Very good"}},"ChoiceOrder":["1","2","3","4","5","6","7"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID261","PrivateData":false}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID262","SecondaryAttribute":"Which response do you think the writer would be more likely to listen to?","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong>Which response do you think the writer would be more likely to listen to?<\/strong><\/p>","DefaultChoices":false,"DataExportTag":"l_1855","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Which response do you think the writer would be more likely to listen to?","Choices":{"1":{"Display":"Definitely Response A"},"2":{"Display":"Probably Response A"},"3":{"Display":"About equally likely to listen to both"},"4":{"Display":"Probably Response B"},"5":{"Display":"Definitely Response B"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID262","PrivateData":false}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID263","SecondaryAttribute":"If you had a personal problem of your own, which of these two commenters would y","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong>If you had a personal problem of your own, which of these two commenters would you rather get advice from?<\/strong><\/p>","DefaultChoices":false,"DataExportTag":"a_1855","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"If you had a personal problem of your own, which of these two commenters would y","Choices":{"1":{"Display":"Definitely commenter A"},"2":{"Display":"Probably commenter A"},"3":{"Display":"No preference"},"4":{"Display":"Probably commenter B"},"5":{"Display":"Definitely commenter B"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID263","PrivateData":false}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID264","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"t_r_1855","QuestionID":"QID264","QuestionType":"Timing","Selector":"PageTimer","DataVisibility":{"Private":false,"Hidden":true},"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3","4"],"Configuration":{"QuestionDescriptionOption":"UseText"}}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID265","SecondaryAttribute":"Situation Am I wrong for walking out when told to wait Wife, 3 young kids, and m","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"margin:0 0 12px 0\"><div style=\"margin:0 0 4px 0;font-weight:600\">Situation<\/div><div style=\"white-space:pre-wrap;overflow:visible;height:auto;min-height:4em;background:#f7f6f3;border:1px solid #d9d6cf;padding:12px;line-height:1.45\">Am I wrong for walking out when told to wait Wife, 3 young kids, and myself go to Costco almost every weekend.\n\nEat lunch after shopping in store last Saturday.\n\nWhen walking out I realize I threw my receipt away with lunch trash.\n\n(Costco employee checks receipt when you exit to deter theft, though there is a large sign that says &quot;we check your receipt to make sure you paid the right price and got the right items,&quot; but its a ridiculous notion that they know the correct prices and would catch a mistake in the process.) Anyway, on to the alleged assholery.\n\nOnly bought 4 things, didn&#x27;t think it would be a big deal.\n\nThere&#x27;s a lovely older woman at the exit I approach:\n\nMe &quot;I accidentally threw my receipt away with lunch&quot;\n\nLady &quot;I&#x27;m sorry I have to call my manager and they&#x27;ll take you to customer service to print a new one&quot; (radios manager immediately)\n\nMe &quot;No thanks, I&#x27;m going to go.&quot;\n\nI casually walk out but my 7yo daughter and wife are mortified.\n\nI never raised my voice, but was definitely projecting annoyance.\n\nWife says because I&#x27;m a very large, pretty memorable person I probably scared the old lady, and they will definitely remember us when we go back this week and we could possibly have our membership revoked.\n\nShe&#x27;s contends that I&#x27;m in the wrong for not following their procedures, and roping my family unwillingly in my supposed wrong decisions.\n\nI contend that no one cares and they were only being procedural drones.\n\nIn short: I saved ~7 minutes of valuable non-Costco time at the expense of not proving I bought turkey, eggs, cheese, and a friggin rotisserie chicken.\n\nAm I wrong?<\/div><\/div><p><strong>Do you think the writer was in the wrong?<\/strong><\/p>","DefaultChoices":false,"DataExportTag":"v_3643","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Situation Am I wrong for walking out when told to wait Wife, 3 young kids, and m","Choices":{"1":{"Display":"Definitely not in the wrong"},"2":{"Display":"Probably not in the wrong"},"3":{"Display":"Unsure"},"4":{"Display":"Probably in the wrong"},"5":{"Display":"Definitely in the wrong"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID265","PrivateData":false}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID266","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"t_v_3643","QuestionID":"QID266","QuestionType":"Timing","Selector":"PageTimer","DataVisibility":{"Private":false,"Hidden":true},"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3","4"],"Configuration":{"QuestionDescriptionOption":"UseText"}}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID267","SecondaryAttribute":"Situation Am I wrong for walking out when told to wait Wife, 3 young kids, and m","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"margin:0 0 12px 0\"><div style=\"margin:0 0 4px 0;font-weight:600\">Situation<\/div><div style=\"white-space:pre-wrap;overflow:visible;height:auto;min-height:4em;background:#f7f6f3;border:1px solid #d9d6cf;padding:12px;line-height:1.45\">Am I wrong for walking out when told to wait Wife, 3 young kids, and myself go to Costco almost every weekend.\n\nEat lunch after shopping in store last Saturday.\n\nWhen walking out I realize I threw my receipt away with lunch trash.\n\n(Costco employee checks receipt when you exit to deter theft, though there is a large sign that says &quot;we check your receipt to make sure you paid the right price and got the right items,&quot; but its a ridiculous notion that they know the correct prices and would catch a mistake in the process.) Anyway, on to the alleged assholery.\n\nOnly bought 4 things, didn&#x27;t think it would be a big deal.\n\nThere&#x27;s a lovely older woman at the exit I approach:\n\nMe &quot;I accidentally threw my receipt away with lunch&quot;\n\nLady &quot;I&#x27;m sorry I have to call my manager and they&#x27;ll take you to customer service to print a new one&quot; (radios manager immediately)\n\nMe &quot;No thanks, I&#x27;m going to go.&quot;\n\nI casually walk out but my 7yo daughter and wife are mortified.\n\nI never raised my voice, but was definitely projecting annoyance.\n\nWife says because I&#x27;m a very large, pretty memorable person I probably scared the old lady, and they will definitely remember us when we go back this week and we could possibly have our membership revoked.\n\nShe&#x27;s contends that I&#x27;m in the wrong for not following their procedures, and roping my family unwillingly in my supposed wrong decisions.\n\nI contend that no one cares and they were only being procedural drones.\n\nIn short: I saved ~7 minutes of valuable non-Costco time at the expense of not proving I bought turkey, eggs, cheese, and a friggin rotisserie chicken.\n\nAm I wrong?<\/div><\/div><p><em>You can re-read the situation above while evaluating the responses.<\/em><\/p><p>Here are two responses to the writer.<\/p><div style=\"display:grid;grid-template-columns:1fr 1fr;gap:12px;align-items:start\"><div style=\"margin:0 0 12px 0\"><div style=\"margin:0 0 4px 0;font-weight:600\">Response A<\/div><div style=\"white-space:pre-wrap;overflow:visible;height:auto;min-height:4em;background:#f7f6f3;border:1px solid #d9d6cf;padding:12px;line-height:1.45\">${e:\/\/Field\/Option A}<\/div><\/div><div style=\"margin:0 0 12px 0\"><div style=\"margin:0 0 4px 0;font-weight:600\">Response B<\/div><div style=\"white-space:pre-wrap;overflow:visible;height:auto;min-height:4em;background:#f7f6f3;border:1px solid #d9d6cf;padding:12px;line-height:1.45\">${e:\/\/Field\/Option B}<\/div><\/div><\/div><p><strong>Overall, how good is each response?<\/strong><\/p><p>Rate each response:<\/p><p>