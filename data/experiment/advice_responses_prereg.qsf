on":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3","4"],"Configuration":{"QuestionDescriptionOption":"UseText"}}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID129","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"t_v_787","QuestionID":"QID129","QuestionType":"Timing","Selector":"PageTimer","DataVisibility":{"Private":false,"Hidden":true},"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3","4"],"Configuration":{"QuestionDescriptionOption":"UseText"}}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID13","SecondaryAttribute":"Situation Am I wrong for openly disapproving of sisters boyfriend? My sister is ","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"margin:0 0 12px 0\"><div style=\"margin:0 0 4px 0;font-weight:600\">Situation<\/div><div style=\"white-space:pre-wrap;overflow:visible;height:auto;min-height:4em;background:#f7f6f3;border:1px solid #d9d6cf;padding:12px;line-height:1.45\">Am I wrong for openly disapproving of sisters boyfriend? My sister is 19 and dating a broke very immature 27 yo guy still in college. I feel sick thinking about it, as do the rest of my family, although I think it bothers me the most. I&#x27;ve openly told her he&#x27;s a perverted loser and she should find someone better, and said to the guy he disgusts me and my family no end. This understandably has upset my sister, although of course she thinks I&#x27;m saying it out of meanness instead of wanting better for her. Am I wrong for here for trying to get her out of a pointless relationship?\n\nI&#x27;m going to fully admit it as well, although his age was off putting if he was into a proper career I could just about look past it. Also I&#x27;m 22 and 18yos (although not date obviously) I have absolutely nothing in common with, which I know is hypocritical but I don&#x27;t care about them like my sister.<\/div><\/div><p><strong>Do you think the writer was in the wrong?<\/strong><\/p>","DefaultChoices":false,"DataExportTag":"v_607","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Situation Am I wrong for openly disapproving of sisters boyfriend? My sister is ","Choices":{"1":{"Display":"Definitely not in the wrong"},"2":{"Display":"Probably not in the wrong"},"3":{"Display":"Unsure"},"4":{"Display":"Probably in the wrong"},"5":{"Display":"Definitely in the wrong"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID13","PrivateData":false}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID130","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"t_r_787","QuestionID":"QID130","QuestionType":"Timing","Selector":"PageTimer","DataVisibility":{"Private":false,"Hidden":true},"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3","4"],"Configuration":{"QuestionDescriptionOption":"UseText"}}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID131","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":