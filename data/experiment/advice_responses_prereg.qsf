eResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID471","PrivateData":false}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID472","SecondaryAttribute":"Which response do you think the writer would be more likely to listen to?","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong>Which response do you think the writer would be more likely to listen to?<\/strong><\/p>","DefaultChoices":false,"DataExportTag":"l_2921","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Which response do you think the writer would be more likely to listen to?","Choices":{"1":{"Display":"Definitely Response A"},"2":{"Display":"Probably Response A"},"3":{"Display":"About equally likely to listen to both"},"4":{"Display":"Probably Response B"},"5":{"Display":"Definitely Response B"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID472","PrivateData":false}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID473","SecondaryAttribute":"If you had a personal problem of your own, which of these two commenters would y","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong>If you had a personal problem of your own, which of these two commenters would you rather get advice from?<\/strong><\/p>","DefaultChoices":false,"DataExportTag":"a_2921","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"If you had a personal problem of your own, which of these two commenters would y","Choices":{"1":{"Display":"Definitely commenter A"},"2":{"Display":"Probably commenter A"},"3":{"Display":"No preference"},"4":{"Display":"Probably commenter B"},"5":{"Display":"Definitely commenter B"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID473","PrivateData":false}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID474","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"t_r_2921","QuestionID":"QID474","QuestionType":"Timing","Selector":"PageTimer","DataVisibility":{"Private":false,"Hidden":true},"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3","4"],"Configuration":{"QuestionDescriptionOption":"UseText"}}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID475","SecondaryAttribute":"Situation Am I wrong for getting mad at my girlfriend for eating our poutine? Th","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"margin:0 0 12px 0\"><div style=\"margin:0 0 4px 0;font-weight:600\">Situation<\/div><div style=\"white-space:pre-wrap;overflow:visible;height:auto;min-height:4em;background:#f7f6f3;border:1px solid #d9d6cf;padding:12px;line-height:1.45\">Am I wrong for getting mad at my girlfriend for eating our poutine? This happened last night. My friends, my girlfriend and I had a long night out at the club and decided we wanted to get food. We decided to stop at Smokes Poutine to get a nice triple pork. So we all get our food and then decide to walk home and eat when we get there.\n\nNow, one thing to note is that it is around -10 degrees celcius. Everyone wants to get home because it&#x27;s cold and we are all hungry. We start walking and then my girlfriend starts to eat our poutine. We are about a 5 minute walk to our place and I start to get annoyed. Our pace has slowed down and the poutine is getting cold. I essentially paid 20 bucks for cold poutine and we all have to be outside longer than we need to. I told her to seal it up and wait 5 minutes but her drunk keeps eating it.\n\nAm I wrong for getting mad at her for eating the poutine?<\/div><\/div><p><strong>Do you think the writer was in the wrong?<\/strong><\/p>","DefaultChoices":false,"DataExportTag":"v_1484","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Situation Am I wrong for getting mad at my girlfriend for eating our poutine? Th","Choices":{"1":{"Display":"Definitely not in the wrong"},"2":{"Display":"Probably not in the wrong"},"3":{"Display":"Unsure"},"4":{"Display":"Probably in the wrong"},"5":{"Display":"Definitely in the wrong"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID475","PrivateData":false}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID476","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"t_v_1484","QuestionID":"QID476","QuestionType":"Timing","Selector":"PageTimer","DataVisibility":{"Private":false,"Hidden":true},"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3","4"],"Configuration":{"QuestionDescriptionOption":"UseText"}}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID477","SecondaryAttribute":"Situation Am I wrong for getting mad at my girlfriend for eating our poutine? Th","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"margin:0 0 12px 0\"><div style=\"margin:0 0 4px 0;font-weight:600\">Situation<\/div><div style=\"white-space:pre-wrap;overflow:visible;height:auto;min-height:4em;background:#f7f6f3;border:1px solid #d9d6cf;padding:12px;line-height:1.45\">Am I wrong for getting mad at my girlfriend for eating our poutine? This happened last night. My friends, my girlfriend and I had a long night out at the club and decided we wanted to get food. We decided to stop at Smokes Poutine to get a nice triple pork. So we all get our food and then decide to walk home and eat when we get there.\n\nNow, one thing to note is that it is around -10 degrees celcius. Everyone wants to get home because it&#x27;s cold and we are all hungry. We start walking and then my girlfriend starts to eat our poutine. We are about a 5 minute walk to our place and I start to get annoyed. Our pace has slowed down and the poutine is getting cold. I essentially paid 20 bucks for cold poutine and we all have to be outside longer than we need to. I told her to seal it up and wait 5 minutes but her drunk keeps eating it.\n\nAm I wrong for getting mad at her for eating the poutine?<\/div><\/div><p><em>You can re-read the situation above while evaluating the responses.<\/em><\/p><p>Here are two responses to the writer.<\/p><div style=\"display:grid;grid-template-columns:1fr 1fr;gap:12px;align-items:start\"><div style=\"margin:0 0 12px 0\"><div style=\"margin:0 0 4px 0;font-weight:600\">Response A<\/div><div style=\"white-space:pre-wrap;overflow:visible;height:auto;min-height:4em;background:#f7f6f3;border:1px solid #d9d6cf;padding:12px;line-height:1.45\">${e:\/\/Field\/Option A}<\/div><\/div><div style=\"margin:0 0 12px 0\"><div style=\"margin:0 0 4px 0;font-weight:600\">Response B<\/div><div style=\"white-space:pre-wrap;overflow:visible;height:auto;min-height:4em;background:#f7f6f3;border:1px solid #d9d6cf;padding:12px;line-height:1.45\">${e:\/\/Field\/Option B}<\/div><\/div><\/div><p><strong>Overall, how good is ea