Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID375","PrivateData":false}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID376","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"t_r_3786","QuestionID":"QID376","QuestionType":"Timing","Selector":"PageTimer","DataVisibility":{"Private":false,"Hidden":true},"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3","4"],"Configuration":{"QuestionDescriptionOption":"UseText"}}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID377","SecondaryAttribute":"Situation Would I be wrong for deleting all of an exes facebook pics? would I be","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"margin:0 0 12px 0\"><div style=\"margin:0 0 4px 0;font-weight:600\">Situation<\/div><div style=\"white-space:pre-wrap;overflow:visible;height:auto;min-height:4em;background:#f7f6f3;border:1px solid #d9d6cf;padding:12px;line-height:1.45\">Would I be wrong for deleting all of an exes facebook pics? would I be wrong if i got into an exes facebook and deleted all of their photos and albums permantely? they cheated on me and got pregnant while i was putting my life on hold to help them...\n\nsome of the albums are of their kid, and frankly i think this is the perfect opportunity to enforce karma upon them, for wasting over half a decade of my life and then cheating on me. we didnt fight. they just decided that it would be more fun to go someone else all of the sudden, while im at home watching their oldest kid..\n\nWould I be wrong for deleting all of someones pics off of their facebook? their account has been logged in on my pc, and i just realized that.<\/div><\/div><p><strong>Do you think the writer was in the wrong?<\/strong><\/p>","DefaultChoices":false,"DataExportTag":"v_3060","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Situation Would I be wrong for deleting all of an exes facebook pics? would I be","Choices":{"1":{"Display":"Definitely not in the wrong"},"2":{"Display":"Probably not in the wrong"},"3":{"Display":"Unsure"},"4":{"Display":"Probably in the wrong"},"5":{"Display":"Definitely in the wrong"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID377","PrivateData":false}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID378","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"t_v_3060","QuestionID":"QID378","QuestionType":"Timing","Selector":"PageTimer","DataVisibility":{"Private":false,"Hidden":true},"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3","4"],"Configuration":{"QuestionDescriptionOption":"UseText"}}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID379","SecondaryAttribute":"Situation Would I be wrong for deleting all of an exes facebook pics? would I be","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"margin:0 0 12px 0\"><div style=\"margin:0 0 4px 0;font-weight:600\">Situation<\/div><div style=\"white-space:pre-wrap;overflow:visible;height:auto;min-height:4em;background:#f7f6f3;border:1px solid #d9d6cf;padding:12px;line-height:1.45\">Would I be wrong for deleting all of an exes facebook pics? would I be wrong if i got into an exes facebook and deleted all of their photos and albums permantely? they cheated on me and got pregnant while i was putting my life on hold to help them...\n\nsome of the albums are of their kid, and frankly i think this is the perfect opportunity to enforce karma upon them, for wasting over half a decade of my life and then cheating on me. we didnt fight. they just decided that it would be more fun to go someone else all of the sudden, while im at home watching their oldest kid..\n\nWould I be wrong for deleting all of someones pics off of their facebook? their account has been logged in on my pc, and i just realized that.<\/div><\/div><p><em>You can re-read the situation above while evaluating the responses.<\/em><\/p><p>Here are two responses to the writer.<\/p><div style=\"display:grid;grid-template-columns:1fr 1fr;gap:12px;align-items:start\"><div style=\"margin:0 0 12px 0\"><div style=\"margin:0 0 4px 0;font-weight:600\">Response A<\/div><div style=\"white-space:pre-wrap;overflow:visible;height:auto;min-height:4em;background:#f7f6f3;border:1px solid #d9d6cf;padding:12px;line-height:1.45\">${e:\/\/Field\/Option A}<\/div><\/div><div style=\"margin:0 0 12px 0\"><div style=\"margin:0 0 4px 0;font-weight:600\">Response B<\/div><div style=\"white-space:pre-wrap;overflow:visible;height:auto;min-height:4em;background:#f7f6f3;border:1px solid #d9d6cf;padding:12px;line-height:1.45\">${e:\/\/Field\/Option B}<\/div><\/div><\/div><p><strong>Overall, how good is each response?<\/strong><\/p><p>Rate each response:<\/p><p><strong>Response A<\/strong><\/p>","DefaultChoices":false,"DataExportTag":"gA_3060","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Situation Would I be wrong for deleting all of an exes facebook pics? would I be","Choices":{"1":{"Display":"Very bad"},"2":{"Display":"Bad"},"3":{"Display":"Somewhat bad"},"4":{"Display":"Neither good nor bad"},"5":{"Display":"Somewhat good"},"6":{"Display":"Good"},"7":{"Display":"Very good"}},"ChoiceOrder":["1","2","3","4","5","6","7"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID379","PrivateData":false}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID38","SecondaryAttribute":"Situation Would I be wrong for buying a gift for my niece and pretending it's fr","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"margin:0 0 12px 0\"><div style=\"margin:0 0 4px 0;font-weight:600\">Situation<\/div><div style=\"white-space:pre-wrap;overflow:visible;height:auto;min-height:4em;background:#f7f6f3;border:1px solid #d9d6cf;padding:12px;line-height:1.45\">Would I be wrong for buying a gift for my niece and pretending it&#x27;s from her estranged aunt? So my sister-in-law A and sister-in-law B are in a petty cold war that NOBODY gets. If we all get together at the parents&#x27; house, sister-in-law A will refuse to come if sister-in-law B is there. Meanwhile, their kids get along just fine. I get along well with both. Sister-in-law B bought my kids Christmas presents, but didn&#x27;t get anything for sister-in-law A&#x27;s kids. My mother-in-law will likely tell sister-in-law A that my kids got presents and hers didn&#x27;t, because she&#x27;s like that. I&#x27;m sick and tired as this really dumb cold war. Sister-in-law B won&#x27;t be around for the holidays, and lives out of town. Should I buy sister-in-law A&#x27;s kids something small and leave it under the tree from sister-in-law B, and just not tell anyone (not even my partner- their brother) it was me?<\/div><\/div><p><em>You can re-read the situation above while evaluating the responses.<\/em><\/p><p>Here are two responses to the writer.<\/p><div style=\"display:grid;grid-template-columns:1fr 1fr;gap:12px;align-items:start\"><div style=\"margin:0 0 12px 0\"><div style=\"margin:0 0 4px 0;font-weight:600\">Response A<\/div><div style=\"white-space:pre-wrap;overflow:visible;height:auto;min-height:4em;background:#f7f6f3;border:1px solid #d9d6cf;padding:12px;line-height:1.45\">${e:\/\/Field\/Option A}<\/div><\/div><div style=\"margin:0 0 12px 0\"><div style=\"margin:0 0 4px 0;font-weight:600\">Response B<\/div><div style=\"white-space:pre-wrap;overflow:visible;height:auto;min-height:4em;background:#f7f6f3;border:1px solid #d9d6cf;padding:12px;line-height:1.45\">${e:\/\/Field\/Option B}<\/div><\/div><\/div><p><strong>Overall, how good is each response?<\/strong><\/p><p>Rate each response:<\/p><p><strong>Response A<\/strong><\/p>","DefaultChoices":false,"DataExportTag":"gA_3804","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Situation Would I be wrong for buying a gift for my niece and pretending it's fr","Choices":{"1":{"Display":"Very bad"},"2":{"Display":"Bad"},"3":{"Display":"Somewhat bad"},"4":{"Display":"Neither good nor bad"},"5":{"Display":"Somewhat good"},"6":{"Display":"Good"},"7":{"Display":"Very good"}},"ChoiceOrder":["1","2","3","4","5","6","7"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID38","PrivateData":false}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID380","SecondaryAttribute":"Response B","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong>Response B<\/strong><\/p>","DefaultChoices":false,"DataExportTag":"gB_3060","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Response B","Choices":{"1":{"Display":"Very bad"},"2":{"Display":"Bad"},"3":{"Display":"Somewhat bad"},"4":{"Display":"Neither good nor bad"},"5":{"Display":"Somewhat good"},"6":{"Display":"Good"},"7":{"Display":"Very good"}},"ChoiceOrder":["1","2","3","4","5","6","7"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID380","PrivateData":false}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID381","SecondaryAttribute":"Which response do you think the writer would be more likely to listen to?","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong>Which response do you think the writer would be more likely to listen to?<\/strong><\/p>","DefaultChoices":false,"DataExportTag":"l_3060","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Which response do you think the writer would be more likely to listen to?","Choices":{"1":{"Display":"Definitely Response A"},"2":{"Display":"Probably Response A"},"3":{"Display":"About equally likely to listen to both"},"4":{"Display":"Probably Response B"},"5":{"Display":"Definitely Response B"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID381","PrivateData":false}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID382","SecondaryAttribute":"If you had a personal problem of your own, which of these two commenters would y","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong>If you had a personal problem of your own, which of these two commenters would you rather get advice from?<\/strong><\/p>","DefaultChoices":false,"DataExportTag":"a_3060","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"If you had a personal problem of your own, which of these two commenters would y","Choices":{"1":{"Display":"Definitely commenter A"},"2":{"Display":"Probably commenter A"},"3":{"Display":"No preference"},"4":{"Display":"Probably commenter B"},"5":{"Display":"Definitely commenter B"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID382","PrivateData":false}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID383","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"t_r_3060","QuestionID":"QID383","QuestionType":"Timing","Selector":"PageTimer","DataVisibility":{"Private":false,"Hidden":true},"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3","4"],"Configuration":{"QuestionDescriptionOption":"UseText"}}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID384","SecondaryAttribute":"Situation Am I wrong for having our sister in law reimburse us for baby stuff af","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"margin:0 0 12px 0\"><div style=\"margin:0 0 4px 0;font-weight:600\">Situation<\/div><div style=\"white-space:pre-wrap;overflow:visible;height:auto;min-height:4em;background:#f7f6f3;border:1px solid #d9d6cf;padding:12px;line-height:1.45\">Am I wrong for having our sister in law reimburse us for baby stuff after she had a termination? Wife&#x27;s sister is (or I guess was) pregnant. It&#x27;s a big thing because she was trying for years with her boyfriend. Her health and the baby&#x27;s health were excellent during checkins so in came flowing the gifts which was her idea. She made a list, gave it to family, and we all went to town.\n\nWe bought her a crib ($1200) and some baby clothes (about $200) in preparation. She also received other gifts from other family members.\n\nShe decided to terminate the pregnancy because her boyfriend left her after an argument. He&#x27;s not involved with her anymore. This is her exact reasoning and politics aside, she doesn&#x27;t even need a reason. Free country, etc. But...\n\nWe told her to return the baby items to us and she refused, saying she&#x27;ll use them one day. Sure, but we can just get it back for you then. This is holding our money hostage. She still refused so we asked to be reimbursed at which she also refused.\n\nTrying to defuse the situation, we then said that this is her birthday and Christmas present for the year and she was none too happy. Knowing we&#x27;re now dealing with a brat, we let it be and aren&#x27;t associating with her for now.\n\nThis caused a cacophony of chaos in the family with many upset with her and many supporting her. Never upset because she had the termination, but because she requested all of these things when she wasn&#x27;t 100% sure she&#x27;d keep the pregnancy.\n\nare we wrong? Please don&#x27;t inject politics into this discussion, thank you.<\/div><\/div><p><strong>Do you think the writer was in the wrong?<\/strong><\/p>","DefaultChoices":false,"DataExportTag":"v_2131","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Situation Am I wrong for having our sister in law reimburse us for baby stuff af","Choices":{"1":{"Display":"Definitely not in the wrong"},"2":{"Display":"Probably not in the wrong"},"3":{"Display":"Unsure"},"4":{"Display":"Probably in the wrong"},"5":{"Display":"Definitely in the wrong"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID384","PrivateData":false}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID385","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"t_v_2131","QuestionID":"QID385","QuestionType":"Timing","Selector":"PageTimer","DataVisibility":{"Private":false,"Hidden":true},"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3","4"],"Configuration":{"QuestionDescriptionOption":"UseText"}}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID386","SecondaryAttribute":"Situation Am I wrong for having our sister in law reimburse us for baby stuff af","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"margin:0 0 12px 0\"><div style=\"margin:0 0 4px 0;font-weight:600\">Situation<\/div><div style=\"white-space:pre-wrap;overflow:visible;height:auto;min-height:4em;background:#f7f6f3;border:1px solid #d9d6cf;padding:12px;line-height:1.45\">Am I wrong for having our sister in law reimburse us for baby stuff after she had a termination? Wife&#x27;s sister is (or I guess was) pregnant. It&#x27;s a big thing because she was trying for years with her boyfriend. Her health and the baby&#x27;s health were excellent during checkins so in came flowing the gifts which was her idea. She made a list, gave it to family, and we all went to town.\n\nWe bought her a crib ($1200) and some baby clothes (about $200) in preparation. She also received other gifts from other family members.\n\nShe decided to terminate the pregnancy because her boyfriend left her after an argument. He&#x27;s not involved with her anymore. This is her exact reasoning and politics aside, she doesn&#x27;t even need a reason. Free country, etc. But...\n\nWe told her to return the baby items to us and she refused, saying she&#x27;ll use them one day. Sure, but we can just get it back for you then. This is holding our money hostage. She still refused so we asked to be reimbursed at which she also refused.\n\nTrying to defuse the situation, we then said that this is her birthday and Christmas present for the year and she was none too happy. Knowing we&#x27;re now dealing with a brat, we let it be and aren&#x27;t associating with her for now.\n\nThis caused a cacophony of chaos in the family with many upset with her and many supporting her. Never upset because she had the termination, but because she requested all of these things when she wasn&#x27;t 100% sure she&#x27;d keep the pregnancy.\n\nare we wrong? Please don&#x27;t inject politics into this discussion, thank you.<\/div><\/div><p><em>You can re-read the situation above while evaluating the responses.<\/em><\/p><p>Here are two responses to the writer.<\/p><div style=\"display:grid;grid-template-columns:1fr 1fr;gap:12px;align-items:start\"><div style=\"margin:0 0 12px 0\"><div style=\"margin:0 0 4px 0;font-weight:600\">Response A<\/div><div style=\"white-space:pre-wrap;overflow:visible;height:auto;min-height:4em;background:#f7f6f3;border:1px solid #d9d6cf;padding:12px;line-height:1.45\">${e:\/\/Field\/Option A}<\/div><\/div><div style=\"margin:0 0 12px 0\"><div style=\"margin:0 0 4px 0;font-weight:600\">Response B<\/div><div style=\"white-space:pre-wrap;overflow:visible;height:auto;min-height:4em;background:#f7f6f3;border:1px solid #d9d6cf;padding:12px;line-height:1.45\">${e:\/\/Field\/Option B}<\/div><\/div><\/div><p><strong>Overall, how good is each response?<\/strong><\/p><p>Rate each response:<\/p><p><strong>Response A<\/strong><\/p>","DefaultChoices":false,"DataExportTag":"gA_2131","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Situation Am I wrong for having our sister in law reimburse us for baby stuff af","Choices":{"1":{"Display":"Very bad"},"2":{"Display":"Bad"},"3":{"Display":"Somewhat bad"},"4":{"Display":"Neither good nor bad"},"5":{"Display":"Somewhat good"},"6":{"Display":"Good"},"7":{"Display":"Very good"}},"ChoiceOrder":["1","2","3","4","5","6","7"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID386","PrivateData":false}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID387","SecondaryAttribute":"Response B","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong>Response B<\/strong><\/p>","DefaultChoices":false,"DataExportTag":"gB_2131","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Response B","Choices":{"1":{"Display":"Very bad"},"2":{"Display":"Bad"},"3":{"Display":"Somewhat bad"},"4":{"Display":"Neither good nor bad"},"5":{"Display":"Somewhat good"},"6":{"Display":"Good"},"7":{"Display":"Very good"}},"ChoiceOrder":["1","2","3","4","5","6","7"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID387","PrivateData":false}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID388","SecondaryAttribute":"Which response do you think the writer would be more likely to listen to?","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong>Which response do you think the writer would be more likely to listen to?<\/strong><\/p>","DefaultChoices":false,"DataExportTag":"l_2131","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Which response do you think the writer would be more likely to listen to?","Choices":{"1":{"Display":"Definitely Response A"},"2":{"Display":"Probably Response A"},"3":{"Display":"About equally likely to listen to both"},"4":{"Display":"Probably Response B"},"5":{"Display":"Definitely Response B"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID388","PrivateData":false}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID389","SecondaryAttribute":"If you had a personal problem of your own, which of these two commenters would y","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong>If you had a personal problem of your own, which of these two commenters would you rather get advice from?<\/strong><\/p>","DefaultChoices":false,"DataExportTag":"a_2131","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"If you had a personal problem of your own, which of these two commenters would y","Choices":{"1":{"Display":"Definitely commenter A"},"2":{"Display":"Probably commenter A"},"3":{"Display":"No preference"},"4":{"Display":"Probably commenter B"},"5":{"Display":"Definitely commenter B"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID389","PrivateData":false}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID39","SecondaryAttribute":"Response B","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong>Response B<\/strong><\/p>","DefaultChoices":false,"DataExportTag":"gB_3804","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Response B","Choices":{"1":{"Display":"Very bad"},"2":{"Display":"Bad"},"3":{"Display":"Somewhat bad"},"4":{"Display":"Neither good nor bad"},"5":{"Display":"Somewhat good"},"6":{"Display":"Good"},"7":{"Display":"Very good"}},"ChoiceOrder":["1","2","3","4","5","6","7"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID39","PrivateData":false}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID390","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"t_r_2131","QuestionID":"QID390","QuestionType":"Timing","Selector":"PageTimer","DataVisibility":{"Private":false,"Hidden":true},"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3","4"],"Configuration":{"QuestionDescriptionOption":"UseText"}}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID391","SecondaryAttribute":"Situation Would I be wrong if I used an online store's delivery system to avoid ","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"margin:0 0 12px 0\"><div style=\"margin:0 0 4px 0;font-weight:600\">Situation<\/div><div style=\"white-space:pre-wrap;overflow:visible;height:auto;min-height:4em;background:#f7f6f3;border:1px solid #d9d6cf;padding:12px;line-height:1.45\">Would I be wrong if I used an online store&#x27;s delivery system to avoid paying the delivery fee? I try to be an honest person and never do things like this ever, concidering it gives me moral qualms, though it is such a small thing.\n\nSo, I need a bleeding kit for my bike with hydrolic discbrakes. FYI, they use oil pressure like cars and need the oil replaced and air bleed out of them. To do this, you either need a special kit or hire a mechanic.\n\nAnyway, I found a kit for about 15$ (not actual currency but converts for ease) but upon buying it, they will slap a 7$ delivery fee ontop which makes the prices far above what I hoped.\n\nHowever, the site has a policy that states that if you order above 50$, you don&#x27;t need to pay the delivery fee.\n\nWhat I am concidering is ordering both the bleeding kit and like a pair of shoes to avoid the fee and then return the shoes which means I don&#x27;t actually have to pay the fee.\n\nI know this works because I needed to return a cycling shirt because in Poland, people there are apparantly really small, and even though my order now came under 50$ through the return, I never got an invoice for the delivery fee.\n\nReturns are also free by company policy.\n\nSo, Would I be wrong?<\/div><\/div><p><strong>Do you think the writer was in the wrong?<\/strong><\/p>","DefaultChoices":false,"DataExportTag":"v_2067","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Situation Would I be wrong if I used an online store's delivery system to avoid ","Choices":{"1":{"Display":"Definitely not in the wrong"},"2":{"Display":"Probably not in the wrong"},"3":{"Display":"Unsure"},"4":{"Display":"Probably in the wrong"},"5":{"Display":"Definitely in the wrong"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID391","PrivateData":false}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID392","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"t_v_2067","QuestionID":"QID392","QuestionType":"Timing","Selector":"PageTimer","DataVisibility":{"Private":false,"Hidden":true},"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3","4"],"Configuration":{"QuestionDescriptionOption":"UseText"}}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID393","SecondaryAttribute":"Situation Would I be wrong if I used an online store's delivery system to avoid ","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"margin:0 0 12px 0\"><div style=\"margin:0 0 4px 0;font-weight:600\">Situation<\/div><div style=\"white-space:pre-wrap;overflow:visible;height:auto;min-height:4em;background:#f7f6f3;border:1px solid #d9d6cf;padding:12px;line-height:1.45\">Would I be wrong if I used an online store&#x27;s delivery system to avoid paying the delivery fee? I try to be an honest person and never do things like this ever, concidering it gives me moral qualms, though it is such a small thing.\n\nSo, I need a bleeding kit for my bike with hydrolic discbrakes. FYI, they use oil pressure like cars and need the oil replaced and air bleed out of them. To do this, you either need a special kit or hire a mechanic.\n\nAnyway, I found a kit for about 15$ (not actual currency but converts for ease) but upon buying it, they will slap a 7$ delivery fee ontop which makes the prices far above what I hoped.\n\nHowever, the site has a policy that states that if you order above 50$, you don&#x27;t need to pay the delivery fee.\n\nWhat I am concidering is ordering both the bleeding kit and like a pair of shoes to avoid the fee and then return the shoes which means I don&#x27;t actually have to pay the fee.\n\nI know this works because I needed to return a cycling shirt because in Poland, people there are apparantly really small, and even though my order now came under 50$ through the return, I never got an invoice for the delivery fee.\n\nReturns are also free by company policy.\n\nSo, Would I be wrong?<\/div><\/div><p><em>You can re-read the situation above while evaluating the responses.<\/em><\/p><p>Here are two responses to the writer.<\/p><div style=\"display:grid;grid-template-columns:1fr 1fr;gap:12px;align-items:start\"><div style=\"margin:0 0 12px 0\"><div style=\"margin:0 0 4px 0;font-weight:600\">Response A<\/div><div style=\"white-space:pre-wrap;overflow:visible;height:auto;min-height:4em;background:#f7f6f3;border:1px solid #d9d6cf;padding:12px;line-height:1.45\">${e:\/\/Field\/Option A}<\/div><\/div><div style=\"margin:0 0 12px 0\"><div style=\"margin:0 0 4px 0;font-weight:600\">Response B<\/div><div style=\"white-space:pre-wrap;overflow:visible;height:auto;min-height:4em;background:#f7f6f3;border:1px solid #d9d6cf;padding:12px;line-height:1.45\">${e:\/\/Field\/Option B}<\/div><\/div><\/div><p><strong>Overall, how good is each response?<\/strong><\/p><p>Rate each response:<\/p><p><strong>Response A<\/strong><\/p>","DefaultChoices":false,"DataExportTag":"gA_2067","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Situation Would I be wrong if I used an online store's delivery system to avoid ","Choices":{"1":{"Display":"Very bad"},"2":{"Display":"Bad"},"3":{"Display":"Somewhat bad"},"4":{"Display":"Neither good nor bad"},"5":{"Display":"Somewhat good"},"6":{"Display":"Good"},"7":{"Display":"Very good"}},"ChoiceOrder":["1","2","3","4","5","6","7"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID393","PrivateData":false}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID394","SecondaryAttribute":"Response B","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong>Response B<\/strong><\/p>","DefaultChoices":false,"DataExportTag":"gB_2067","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Response B","Choices":{"1":{"Display":"Very bad"},"2":{"Display":"Bad"},"3":{"Display":"Somewhat bad"},"4":{"Display":"Neither good nor bad"},"5":{"Display":"Somewhat good"},"6":{"Display":"Good"},"7":{"Display":"Very good"}},"ChoiceOrder":["1","2","3","4","5","6","7"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID394","PrivateData":false}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID395","SecondaryAttribute":"Which response do you think the writer would be more likely to listen to?","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong>Which response do you think the writer would be more likely to listen to?<\/strong><\/p>","DefaultChoices":false,"DataExportTag":"l_2067","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Which response do you think the writer would be more likely to listen to?","Choices":{"1":{"Display":"Definitely Response A"},"2":{"Display":"Probably Response A"},"3":{"Display":"About equally likely to listen to both"},"4":{"Display":"Probably Response B"},"5":{"Display":"Definitely Response B"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID395","PrivateData":false}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID396","SecondaryAttribute":"If you had a personal problem of your own, which of these two commenters would y","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong>If you had a personal problem of your own, which of these two commenters would you rather get advice from?<\/strong><\/p>","DefaultChoices":false,"DataExportTag":"a_2067","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"If you had a personal problem of your own, which of these two commenters would y","Choices":{"1":{"Display":"Definitely commenter A"},"2":{"Display":"Probably commenter A"},"3":{"Display":"No preference"},"4":{"Display":"Probably commenter B"},"5":{"Display":"Definitely commenter B"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID396","PrivateData":false}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID397","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"t_r_2067","QuestionID":"QID397","QuestionType":"Timing","Selector":"PageTimer","DataVisibility":{"Private":false,"Hidden":true},"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3","4"],"Configuration":{"QuestionDescriptionOption":"UseText"}}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID398","SecondaryAttribute":"Situation Would I be wrong if I call my coworker out on passing off Reddit jokes","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"margin:0 0 12px 0\"><div style=\"margin:0 0 4px 0;font-weight:600\">Situation<\/div><div style=\"white-space:pre-wrap;overflow:visible;height:auto;min-height:4em;background:#f7f6f3;border:1px solid #d9d6cf;padding:12px;line-height:1.45\">Would I be wrong if I call my coworker out on passing off Reddit jokes as his own? Allright, so I have this coworker that I have now caught 3 times passing off Reddit jokes as his own.\n\nThe first time was about how he was eating at Burger King and the gay cashier told a customer not to be rude because he was gay and the customer told him wrong, that he likes d*** too. I laughed, and then a couple hours later, saw the meme on here and just shook my head.\n\nThe second time, he related a story that someone asked when you knew your kid was really dumb and how some kid threw their shoe out the window and didn&#x27;t want her dad to be mad. He said his little daughter did that. Again, I just shook my head and went about my business, as this time, I had literally just seen that post and actually read quite a few of the stories.\n\nThen, just this morning, he really tried to say that he got a haircut to look like his friend when he was a little kid so their teacher couldn&#x27;t tell them apart, but that his friend was black. This time, another one of my coworkers looked at me wide eyed and I told her that was the 3rd time I&#x27;ve caught him stealing internet jokes and passing them off as my own. She said, oh yeah, thats a Reddit joke.\n\nSo, would I be wrong if I call this guy out for being so unoriginal?<\/div><\/div><p><strong>Do you think the writer was in the wrong?<\/strong><\/p>","DefaultChoices":false,"DataExportTag":"v_3294","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Situation Would I be wrong if I call my coworker out on passing off Reddit jokes","Choices":{"1":{"Display":"Definitely not in the wrong"},"2":{"Display":"Probably not in the wrong"},"3":{"Display":"Unsure"},"4":{"Display":"Probably in the wrong"},"5":{"Display":"Definitely in the wrong"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID398","PrivateData":false}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID399","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"t_v_3294","QuestionID":"QID399","QuestionType":"Timing","Selector":"PageTimer","DataVisibility":{"Private":false,"Hidden":true},"Validation":{"Settings":{"Type":"None"}},"GradingData