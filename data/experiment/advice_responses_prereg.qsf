adingData":[],"Language":[],"QuestionID":"QID87","PrivateData":false}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID88","SecondaryAttribute":"If you had a personal problem of your own, which of these two commenters would y","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong>If you had a personal problem of your own, which of these two commenters would you rather get advice from?<\/strong><\/p>","DefaultChoices":false,"DataExportTag":"a_607","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"If you had a personal problem of your own, which of these two commenters would y","Choices":{"1":{"Display":"Definitely commenter A"},"2":{"Display":"Probably commenter A"},"3":{"Display":"No preference"},"4":{"Display":"Probably commenter B"},"5":{"Display":"Definitely commenter B"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID88","PrivateData":false}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID89","SecondaryAttribute":"If you had a personal problem of your own, which of these two commenters would y","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong>If you had a personal problem of your own, which of these two commenters would you rather get advice from?<\/strong><\/p>","DefaultChoices":false,"DataExportTag":"a_3488","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"If you had a personal problem of your own, which of these two commenters would y","Choices":{"1":{"Display":"Definitely commenter A"},"2":{"Display":"Probably commenter A"},"3":{"Display":"No preference"},"4":{"Display":"Probably commenter B"},"5":{"Display":"Definitely commenter B"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID89","PrivateData":false}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID9","SecondaryAttribute":"Situation Am I wrong for telling our 4 year old son that Santa doesn't actually ","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"margin:0 0 12px 0\"><div style=\"margin:0 0 4px 0;font-weight:600\">Situation<\/div><div style=\"white-space:pre-wrap;overflow:visible;height:auto;min-height:4em;background:#f7f6f3;border:1px solid #d9d6cf;padding:12px;line-height:1.45\">Am I wrong for telling our 4 year old son that Santa doesn&#x27;t actually exist? So I&#x27;m 27 my wife is 26 and our son is 4. Now let me just preface this by saying I was told by my parents at a very young age and I&#x27;ve always felt that I&#x27;d do the same for my kids. Our son loves Christmas and always goes crazy with excitement. So up until now I&#x27;ve gone along with my wife on it. Out Well a couple nights ago it was just our son and I home at night, my wife was out with her friends. We were on the couch together and he saw a santa commercial and he was like ohh Santa, Santa soon and I saw it as an opportunity to tell him the truth about the holiday. He then started getting upset about it and I tried calming him down telling him that he will still get everything that he wants. I didn&#x27;t see the problem with it because I was being honest with him and I don&#x27;t wanna deceive him. A couple hours later my wife comes home and of course he runs over to her and tells her about it. She was furious with me about it, but I told her that I felt it&#x27;s justified because I&#x27;m being honest with our son. Am I wrong?<\/div><\/div><p><strong>Do you think the writer was in the wrong?<\/strong><\/p>","DefaultChoices":false,"DataExportTag":"v_939","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Co