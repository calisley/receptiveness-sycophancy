o listen to both"},"4":{"Display":"Probably Response B"},"5":{"Display":"Definitely Response B"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID563","PrivateData":false}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID564","SecondaryAttribute":"If you had a personal problem of your own, which of these two commenters would y","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong>If you had a personal problem of your own, which of these two commenters would you rather get advice from?<\/strong><\/p>","DefaultChoices":false,"DataExportTag":"a_1738","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"If you had a personal problem of your own, which of these two commenters would y","Choices":{"1":{"Display":"Definitely commenter A"},"2":{"Display":"Probably commenter A"},"3":{"Display":"No preference"},"4":{"Display":"Probably commenter B"},"5":{"Display":"Definitely commenter B"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID564","PrivateData":false}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID565","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"t_r_1738","QuestionID":"QID565","QuestionType":"Timing","Selector":"PageTimer","DataVisibility":{"Private":false,"Hidden":true},"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3","4"],"Configuration":{"QuestionDescriptionOption":"UseText"}}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID566","SecondaryAttribute":"Situation Am I wrong for not checking my phone A couple weeks ago I had a weddin","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"margin:0 0 12px 0\"><div style=\"margin:0 0 4px 0;font-weight:600\">Situation<\/div><div style=\"white-space:pre-wrap;overflow:visible;height:auto;min-height:4em;background:#f7f6f3;border:1px solid #d9d6cf;padding:12px;line-height:1.45\">Am I wrong for not checking my phone A couple weeks ago I had a wedding to attend. A friend of mine was having a cookout and casual reception at his house with setup the night before. The wedding fell on my wedding anniversary.\n\nMy wife was planning to stay home with our three kids and I told her I was just going to go to the 11am ceremony and then come home so we could all do something as a family. The kids had a birthday party to go to so it worked out.\n\nWell time got away from me and I ended up staying until midnight. I checked my phone as I was leaving and saw a couple of missed calls and texts from my wife, wondering what was going on. Turns out she had also called a mutual friend who had been at the wedding, but they had left around 3pm so didn&#x27;t have any news for her.\n\nWife is unbelievably angry. I told her I didn&#x27;t have cell service inside - the place has a metal roof. She thinks I&#x27;m full of stuff and is mad that I didn&#x27;t take the initiative to go outside for better service.\n\nAm I wrong?<\/div><\/div><p><strong>Do you think the writer was in the wrong?<\/strong><\/p>","DefaultChoices":false,"DataExportTag":"v_1049","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Situation Am I wrong for not checking my phone A couple weeks ago I had a weddin","Choices":{"1":{"Display":"Definitely not in the wrong"},"2":{"Display":"Probably not in the wrong"},"3":{"Display":"Unsure"},"4":{"Display":"Probably in the wrong"},"5":{"Display":"Definitely in the wrong"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID566","PrivateData":false}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID567","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"t_v_1049","QuestionID":"QID567","QuestionType":"Timing","Selector":"PageTimer","DataVisibility":{"Private":false,"Hidden":true},"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3","4"],"Configuration":{"QuestionDescriptionOption":"UseText"}}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID568","SecondaryAttribute":"Situation Am I wrong for not checking my phone A couple weeks ago I had a weddin","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"margin:0 0 12px 0\"><div style=\"margin:0 0 4px 0;font-weight:600\">Situation<\/div><div style=\"white-space:pre-wrap;overflow:visible;height:auto;min-height:4em;background:#f7f6f3;border:1px solid #d9d6cf;padding:12px;line-height:1.45\">Am I wrong for not checking my phone A couple weeks ago I had a wedding to attend. A friend of mine was having a cookout and casual reception at his house with setup the night before. The wedding fell on my wedding anniversary.\n\nMy wife was planning to stay home with our three kids and I told her I was just going to go to the 11am ceremony and then come home so we could all do something as a family. The kids had a birthday party to go to so it worked out.\n\nWell time got away from me and I ended up staying until midnight. I checked my phone as I was leaving and saw a couple of missed calls and texts from my wife, wondering what was going on. Turns out she had also called a mutual friend who had been at the wedding, but they had left around 3pm so didn&#x27;t have any news for her.\n\nWife is unbelievably angry. I told her I didn&#x27;t have cell service inside - the place has a metal roof. She thinks I&#x27;m full of stuff and is mad that I didn&#x27;t take the initiative to go outside for better service.\n\nAm I wrong?<\/div><\/div><p><em>You can re-read the situation above while evaluating the responses.<\/em><\/p><p>Here are two responses to the writer.<\/p><div style=\"display:grid;grid-template-columns:1fr 1fr;gap:12px;align-items:start\"><div style=\"margin:0 0 12px 0\"><div style=\"margin:0 0 4px 0;font-weight:600\">Response A<\/div><div style=\"white-space:pre-wrap;overflow:visible;height:auto;min-height:4em;background:#f7f6f3;border:1px solid #d9d6cf;padding:12px;line-height:1.45\">${e:\/\/Field\/Option A}<\/div><\/div><div style=\"margin:0 0 12px 0\"><div style=\"margin:0 0 4px 0;font-weight:600\">Response B<\/div><div style=\"white-space:pre-wrap;overflow:visible;height:auto;min-height:4em;background:#f7f6f3;border:1px solid #d9d6cf;padding:12px;line-height:1.45\">${e:\/\/Field\/Option B}<\/div><\/div><\/div><p><strong>Overall, how good is each response?<\/strong><\/p><p>Rate each response:<\/p><p><strong>Response A<\/strong><\/p>","DefaultChoices":false,"DataExportTag":"gA_1049","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Situation Am I wrong for not checking my phone A couple weeks ago I had a weddin","Choices":{"1":{"Display":"Very bad"},"2":{"Display":"Bad"},"3":{"Display":"Somewhat bad"},"4":{"Display":"Neither good nor bad"},"5":{"Display":"Somewhat good"},"6":{"Display":"Good"},"7":{"Display":"Very good"}},"ChoiceOrder":["1","2","3","4","5","6","7"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID568","PrivateData":false}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID569","SecondaryAttribute":"Response B","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong>Response B<\/strong><\/p>","DefaultChoices":false,"DataExportTag":"gB_1049","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Response B","Choices":{"1":{"Display":"Very bad"},"2":{"Display":"Bad"},"3":{"Display":"Somewhat bad"},"4":{"Display":"Neither good nor bad"},"5":{"Display":"Somewhat good"},"6":{"Display":"Good"},"7":{"Display":"Very good"}},"ChoiceOrder":["1","2","3","4","5","6","7"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID569","PrivateData":false}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID57","SecondaryAttribute":"Situation Am I wrong for giving my son extra studies in the summer My 14 year ol","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"margin:0 0 12px 0\"><div style=\"margin:0 0 4px 0;font-weight:600\">Situation<\/div><div style=\"white-space:pre-wrap;overflow:visible;height:auto;min-height:4em;background:#f7f6f3;border:1px solid #d9d6cf;padding:12px;line-height:1.45\">Am I wrong for giving my son extra studies in the summer My 14 year old son plays video games all summer, he wants to be a pro gamer and wants to &quot;share&quot; his gaming online for a job. I don&#x27;t think that will be a good and reliable job, so I made him go to an intense summer school for this summer break. He showed me how much homework there is to do. I agreed that there is a lot, so I asked the teachers for less homework. He cries about it and I just tell him its okay and that he can do it. He keeps saying that it&#x27;s a summer break and that it should be time to rest from school but all he does is play games for, &quot;practice&quot;, to get better&quot;, and &quot;for my team and my future.&quot;\n\nI just want him to have a better future with better grades (he has straight &quot;B&quot;s), but am I wrong?<\/div><\/div><p><strong>Do you think the writer was in the wrong?<\/strong><\/p>","DefaultChoices":false,"DataExportTag":"v_3920","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Situation Am I wrong for giving my son extra studies in the summer My 14 year ol","Choices":{"1":{"Display":"Definitely not in the wrong"},"2":{"Display":"Probably not in the wrong"},"3":{"Display":"Unsure"},"4":{"Display":"Probably in the wrong"},"5":{"Display":"Definitely in the wrong"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID57","PrivateData":false}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID570","SecondaryAttribute":"Which response do you think the writer would be more likely to listen to?","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong>Which response do you think the writer would be more likely to listen to?<\/strong><\/p>","DefaultChoices":false,"DataExportTag":"l_1049","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Which response do you think the writer would be more likely to listen to?","Choices":{"1":{"Display":"Definitely Response A"},"2":{"Display":"Probably Response A"},"3":{"Display":"About equally likely to listen to both"},"4":{"Display":"Probably Response B"},"5":{"Display":"Definitely Response B"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID570","PrivateData":false}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID571","SecondaryAttribute":"If you had a personal problem of your own, which of these two commenters would y","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong>If you had a personal problem of your own, which of these two commenters would you rather get advice from?<\/strong><\/p>","DefaultChoices":false,"DataExportTag":"a_1049","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"If you had a personal problem of your own, which of these two commenters would y","Choices":{"1":{"Display":"Definitely commenter A"},"2":{"Display":"Probably commenter A"},"3":{"Display":"No preference"},"4":{"Display":"Probably commenter B"},"5":{"Display":"Definitely commenter B"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID571","PrivateData":false}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID572","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"t_r_1049","QuestionID":"QID572","QuestionType":"Timing","Selector":"PageTimer","DataVisibility":{"Private":false,"Hidden":true},"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3","4"],"Configuration":{"QuestionDescriptionOption":"UseText"}}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID573","SecondaryAttribute":"Situation Am I wrong for ruining my friend's pickle eating experience? I had a f","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"margin:0 0 12px 0\"><div style=\"margin:0 0 4px 0;font-weight:600\">Situation<\/div><div style=\"white-space:pre-wrap;overflow:visible;height:auto;min-height:4em;background:#f7f6f3;border:1px solid #d9d6cf;padding:12px;line-height:1.45\">Am I wrong for ruining my friend&#x27;s pickle eating experience? I had a friend over a few weeks ago and got up to grab a beer. I noticed the jar of pickles in the fridge and decided I could go for some crunch, called out &quot;Hey, you want a pickle?&quot; &quot;Sure.&quot;\n\nI come back into the living room with the beer and two pickles, hand him one.\n\n&quot;Can I have a plate, knife and fork?&quot;\n\n&quot;What for?&quot;\n\n&quot;It&#x27;s how I like to eat my pickles.&quot;\n\n&quot;Seriously?&quot;\n\n&quot;Yeah.&quot;\n\n&quot;... Seriously?&quot;\n\n&quot;Yes.&quot;\n\n&quot;It&#x27;s a pickle. It&#x27;s one pickle.&quot;\n\n&quot;That&#x27;s how I like &#x27;em.&quot;\n\n&quot;I mean... Sorry, but no&quot;\n\n&quot;Wow.&quot;\n\n&quot;Wow? Hold up, you&#x27;re offended?&quot;\n\n&quot;sigh I don&#x27;t know man, it kind of goes against the rules of being a good host.&quot;\n\n&quot;Right. Just one thing. When you asked for a plate, knife, and fork, were you planning on washing those?&quot;\n\n&quot;Wow. Really?&quot;\n\n&quot;Were you?&quot;\n\n&quot;Of course not.&quot;\n\n&quot;Right. So let me get this straight, what&#x27;s implied here is you want me, expect me, to wash three items of dishes later so that you can eat one pickle. To be a good host.&quot;\n\n&quot;Yeah, I guess.&quot;\n\n&quot;You look offended. Am I in the wrong here?&quot;\n\nSo, was I?<\/div><\/div><p><strong>Do you think the writer was in the wrong?<\/strong><\/p>","DefaultChoices":false,"DataExportTag":"v_3012","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Situation Am I wrong for ruining my friend's pickle eating experience? I had a f","Choices":{"1":{"Display":"Definitely not in the wrong"},"2":{"Display":"Probably not in the wrong"},"3":{"Display":"Unsure"},"4":{"Display":"Probably in the wrong"},"5":{"Display":"Definitely in the wrong"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID573","PrivateData":false}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID574","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"t_v_3012","QuestionID":"QID574","QuestionType":"Timing","Selector":"PageTimer","DataVisibility":{"Private":false,"Hidden":true},"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3","4"],"Configuration":{"QuestionDescriptionOption":"UseText"}}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID575","SecondaryAttribute":"Situation Am I wrong for ruining my friend's pickle eating experience? I had a f","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"margin:0 0 12px 0\"><div style=\"margin:0 0 4px 0;font-weight:600\">Situation<\/div><div style=\"white-space:pre-wrap;overflow:visible;height:auto;min-height:4em;background:#f7f6f3;border:1px solid #d9d6cf;padding:12px;line-height:1.45\">Am I wrong for ruining my friend&#x27;s pickle eating experience? I had a friend over a few weeks ago and got up to grab a beer. I noticed the jar of pickles in the fridge and decided I could go for some crunch, called out &quot;Hey, you want a pickle?&quot; &quot;Sure.&quot;\n\nI come back into the living room with the beer and two pickles, hand him one.\n\n&quot;Can I have a plate, knife and fork?&quot;\n\n&quot;What for?&quot;\n\n&quot;It&#x27;s how I like to eat my pickles.&quot;\n\n&quot;Seriously?&quot;\n\n&quot;Yeah.&quot;\n\n&quot;... Seriously?&quot;\n\n&quot;Yes.&quot;\n\n&quot;It&#x27;s a pickle. It&#x27;s one pickle.&quot;\n\n&quot;That&#x27;s how I like &#x27;em.&quot;\n\n&quot;I mean... Sorry, but no&quot;\n\n&quot;Wow.&quot;\n\n&quot;Wow? Hold up, you&#x27;re offended?&quot;\n\n&quot;sigh I don&#x27;t know man, it kind of goes against the rules of being a good host.&quot;\n\n&quot;Right. Just one thing. When you asked for a plate, knife, and fork, were you planning on washing those?&quot;\n\n&quot;Wow. Really?&quot;\n\n&quot;Were you?&quot;\n\n&quot;Of course not.&quot;\n\n&quot;Right. So let me get this straight, what&#x27;s implied here is you want me, expect me, to wash three items of dishes later so that you can eat one pickle. To be a good host.&quot;\n\n&quot;Yeah, I guess.&quot;\n\n&quot;You look offended. Am I in the wrong here?&quot;\n\nSo, was I?<\/div><\/div><p><em>You can re-read the situation above while evaluating the responses.<\/em><\/p><p>Here are two responses to the writer.<\/p><div style=\"display:grid;grid-template-columns:1fr 1fr;gap:12px;align-items:start\"><div style=\"margin:0 0 12px 0\"><div style=\"margin:0 0 4px 0;font-weight:600\">Response A<\/div><div style=\"white-space:pre-wrap;overflow:visible;height:auto;min-height:4em;background:#f7f6f3;border:1px solid #d9d6cf;padding:12px;line-height:1.45\">${e:\/\/Field\/Option A}<\/div><\/div><div style=\"margin:0 0 12px 0\"><div style=\"margin:0 0 4px 0;font-weight:600\">Response B<\/div><div style=\"white-space:pre-wrap;overflow:visible;height:auto;min-height:4em;background:#f7f6f3;border:1px solid #d9d6cf;padding:12px;line-height:1.45\">${e:\/\/Field\/Option B}<\/div><\/div><\/div><p><strong>Overall, how good is each response?<\/strong><\/p><p>Rate each response:<\/p><p><strong>Response A<\/strong><\/p>","DefaultChoices":false,"DataExportTag":"gA_3012","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Situation Am I wrong for ruining my friend's pickle eating experience? I had a f","Choices":{"1":{"Display":"Very bad"},"2":{"Display":"Bad"},"3":{"Display":"Somewhat bad"},"4":{"Display":"Neither good nor bad"},"5":{"Display":"Somewhat good"},"6":{"Display":"Good"},"7":{"Display":"Very good"}},"ChoiceOrder":["1","2","3","4","5","6","7"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID575","PrivateData":false}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID576","SecondaryAttribute":"Response B","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong>Response B<\/strong><\/p>","DefaultChoices":false,"DataExportTag":"gB_3012","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Response B","Choices":{"1":{"Display":"Very bad"},"2":{"Display":"Bad"},"3":{"Display":"Somewhat bad"},"4":{"Display":"Neither good nor bad"},"5":{"Display":"Somewhat good"},"6":{"Display":"Good"},"7":{"Display":"Very good"}},"ChoiceOrder":["1","2","3","4","5","6","7"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID576","PrivateData":false}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID577","SecondaryAttribute":"Which response do you think the writer would be more likely to listen to?","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong>Which response do you think the writer would be more likely to listen to?<\/strong><\/p>","DefaultChoices":false,"DataExportTag":"l_3012","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Which response do you think the writer would be more likely to listen to?","Choices":{"1":{"Display":"Definitely Response A"},"2":{"Display":"Probably Response A"},"3":{"Display":"About equally likely to listen to both"},"4":{"Display":"Probably Response B"},"5":{"Display":"Definitely Response B"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID577","PrivateData":false}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID578","SecondaryAttribute":"If you had a personal problem of your own, which of these two commenters would y","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong>If you had a personal problem of your own, which of these two commenters would you rather get advice from?<\/strong><\/p>","DefaultChoices":false,"DataExportTag":"a_3012","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"If you had a personal problem of your own, which of these two commenters would y","Choices":{"1":{"Display":"Definitely commenter A"},"2":{"Display":"Probably commenter A"},"3":{"Display":"No preference"},"4":{"Display":"Probably commenter B"},"5":{"Display":"Definitely commenter B"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID578","PrivateData":false}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID579","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"t_r_3012","QuestionID":"QID579","QuestionType":"Timing","Selector":"PageTimer","DataVisibility":{"Private":false,"Hidden":true},"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3","4"],"Configuration":{"QuestionDescriptionOption":"UseText"}}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID58","SecondaryAttribute":"Situation Am I wrong for giving my son extra studies in the summer My 14 year ol","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"margin:0 0 12px 0\"><div style=\"margin:0 0 4px 0;font-weight:600\">Situation<\/div><div style=\"white-space:pre-wrap;overflow:visible;height:auto;min-height:4em;background:#f7f6f3;border:1px solid #d9d6cf;padding:12px;line-height:1.45\">Am I wrong for giving my son extra studies in the summer My 14 year old son plays video games all summer, he wants to be a pro gamer and wants to &quot;share&quot; his gaming online for a job. I don&#x27;t think that will be a good and reliable job, so I made him go to an intense summer school for this summer break. He showed me how much homework there is to do. I agreed that there is a lot, so I asked the teachers for less homework. He cries about it and I just tell him its okay and that he can do it. He keeps saying that it&#x27;s a summer break and that it should be time to rest from school but all he does is play games for, &quot;practice&quot;, to get better&quot;, and &quot;for my team and my future.&quot;\n\nI just want him to have a better future with better grades (he has straight &quot;B&quot;s), but am I wrong?<\/div><\/div><p><em>You can re-read the situation above while evaluating the responses.<\/em><\/p><p>Here are two responses to the writer.<\/p><div style=\"display:grid;grid-template-columns:1fr 1fr;gap:12px;align-items:start\"><div style=\"margin:0 0 12px 0\"><div style=\"margin:0 0 4px 0;font-weight:600\">Response A<\/div><div style=\"white-space:pre-wrap;overflow:visible;height:auto;min-height:4em;background:#f7f6f3;border:1px solid #d9d6cf;padding:12px;line-height:1.45\">${e:\/\/Field\/Option A}<\/div><\/div><div style=\"margin:0 0 12px 0\"><div style=\"margin:0 0 4px 0;font-weight:600\">Response B<\/div><div style=\"white-space:pre-wrap;overflow:visible;height:auto;min-height:4em;background:#f7f6f3;border:1px solid #d9d6cf;padding:12px;line-height:1.45\">${e:\/\/Field\/Option B}<\/div><\/div><\/div><p><strong>Overall, how good is each response?<\/strong><\/p><p>Rate each response:<\/p><p><strong>Response A<\/strong><\/p>","DefaultChoices":false,"DataExportTag":"gA_3920","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Situation Am I wrong for giving my son extra studies in the summer My 14 year ol","Choices":{"1":{"Display":"Very bad"},"2":{"Display":"Bad"},"3":{"Display":"Somewhat bad"},"4":{"Display":"Neither good nor bad"},"5":{"Display":"Somewhat good"},"6":{"Display":"Good"},"7":{"Display":"Very good"}},"ChoiceOrder":["1","2","3","4","5","6","7"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID58","PrivateData":false}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID580","SecondaryAttribute":"Situation Am I wrong for Lady refuses to give us money but gives it to this othe","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"margin:0 0 12px 0\"><div style=\"margin:0 0 4px 0;font-weight:600\">Situation<\/div><div style=\"white-space:pre-wrap;overflow:visible;height:auto;min-height:4em;background:#f7f6f3;border:1px solid #d9d6cf;padding:12px;line-height:1.45\">Am I wrong for Lady refuses to give us money but gives it to this other guy Am I wrong: Kinda &quot;are we wrong&quot;. This is my family&#x27;s story.\n\nCharacters involve: Me-me Dad-D Mom-M Sister-S Bitch-B\n\nWe need to go to this store to cash a check. D walks ahead from the rest of us, since they stop cashing checks at 8:00. It&#x27;s 7:59. The rest of us walk in at 8:00, and D tells us they won&#x27;t cash his check because &quot;We close at 8:00 and I&#x27;m out of money.&quot; M walks over and gets the same spiel. We all go back to get milk and we are upset since that was our money to get dinner. There were 2 guys in line when we left,and D spent the whole time saying that if the second guy got his check cashed he was going to go off. We get back, M and S go to check out while me and D go by the area they use to cash checks(now called CC). Second guy gets his check cashed, and D says rather loudly to me &quot;Guess she found some more money&quot;. I agree. We leave some more passive aggressive comments then leave. I can&#x27;t tell if we are in the wrong or not, are we wrong?<\/div><\/div><p><strong>Do you think the writer was in the wrong?<\/strong><\/p>","DefaultChoices":false,"DataExportTag":"v_2473","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Situation Am I wrong for Lady refuses to give us money but gives it to this othe","Choices":{"1":{"Display":"Definitely not in the wrong"},"2":{"Display":"Probably not in the wrong"},"3":{"Display":"Unsure"},"4":{"Display":"Probably in the wrong"},"5":{"Display":"Definitely in the wrong"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID580","PrivateData":false}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID581","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"t_v_2473","QuestionID":"QID581","QuestionType":"Timing","Selector":"PageTimer","DataVisibility":{"Private":false,"Hidden":true},"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3","4"],"Configuration":{"QuestionDescriptionOption":"UseText"}}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID582","SecondaryAttribute":"Situation Am I wrong for Lady refuses to give us money but gives it to this othe","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"margin:0 0 12px 0\"><div style=\"margin:0 0 4px 0;font-weight:600\">Situation<\/div><div style=\"white-space:pre-wrap;overflow:visible;height:auto;min-height:4em;background:#f7f6f3;border:1px solid #d9d6cf;padding:12px;line-height:1.45\">Am I wrong for Lady refuses to give us money but gives it to this other guy Am I wrong: Kinda &quot;are we wrong&quot;. This is my family&#x27;s story.\n\nCharacters involve: Me-me Dad-D Mom-M Sister-S Bitch-B\n\nWe need to go to this store to cash a check. D walks ahead from the rest of us, since they stop cashing checks at 8:00. It&#x27;s 7:59. The rest of us walk in at 8:00, and D tells us they won&#x27;t cash his check because &quot;We close at 8:00 and I&#x27;m out of money.&quot; M walks over and gets the same spiel. We all go back to get milk and we are upset since that was our money to get dinner. There were 2 guys in line when we left,and D spent the whole time saying that if the second guy got his check cashed he was going to go off. We get back, M and S go to check out while me and D go by the area they use to cash checks(now called CC). Second guy gets his check cashed, and D says rather loudly to me &quot;Guess she found some more money&quot;. I agree. We leave some more passive aggressive comments then leave. I can&#x27;t tell if we are in the wrong or not, are we wrong?<\/div><\/div><p><em>You can re-read the situation above while evaluating the responses.<\/em><\/p><p>Here are two responses to the writer.<\/p><div style=\"display:grid;grid-template-columns:1fr 1fr;gap:12px;align-items:start\"><div style=\"margin:0 0 12px 0\"><div style=\"margin:0 0 4px 0;font-weight:600\">Response A<\/div><div style=\"white-space:pre-wrap;overflow:visible;height:auto;min-height:4em;background:#f7f6f3;border:1px solid #d9d6cf;padding:12px;line-height:1.45\">${e:\/\/Field\/Option A}<\/div><\/div><div style=\"margin:0 0 12px 0\"><div style=\"margin:0 0 4px 0;font-weight:600\">Response B<\/div><div style=\"white-space:pre-wrap;overflow:visible;height:auto;min-height:4em;background:#f7f6f3;border:1px solid #d9d6cf;padding:12px;line-height:1.45\">${e:\/\/Field\/Option B}<\/div><\/div><\/div><p><strong>Overall, how good is each response?<\/strong><\/p><p>Rate each response:<\/p><p><strong>Response A<\/strong><\/p>","DefaultChoices":false,"DataExportTag":"gA_2473","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Situation Am I wrong for Lady refuses to give us money but gives it to this othe","Choices":{"1":{"Display":"Very bad"},"2":{"Display":"Bad"},"3":{"Display":"Somewhat bad"},"4":{"Display":"Neither good nor bad"},"5":{"Display":"Somewhat good"},"6":{"Display":"Good"},"7":{"Display":"Very good"}},"ChoiceOrder":["1","2","3","4","5","6","7"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID582","PrivateData":false}},{"SurveyID":"SV_ekvji0xKlx9Ac7Q","Element":"SQ","PrimaryAttribute":"QID583","SecondaryAttribute":"Response B","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong>Response B<\/strong><\/p>","DefaultChoices":false,"DataExportTag":"gB_2473","QuestionType":"MC","Selector":"SAHR","